  "name": "Grant approval, reservation and funding (sponsor side)",
  "release": "R1",
  "outcome": "A lawful, sponsor-authorized grant reserved atomically against authoritative capacity and funded exactly once before any payment",
  "aggregate": "Grant",
  "sources": [
    "RR-REQ-X-002-r1",
    "UNB-RCN-FIN-008",
