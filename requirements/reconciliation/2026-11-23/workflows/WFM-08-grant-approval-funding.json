    "CROSS-WORKFLOW-FINANCIAL-AUTHORITY-AND-IRREVERSIBILITY-INVARIANTS-2026-11-23.md"
  ],
  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-004",
    "UNB-UI-S-008",
    "UNB-UI-S-011",
    "UNB-UI-S-012",
