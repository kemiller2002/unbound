  ],
  "states": [
    {
      "id": "GrantUnderReview",
      "kind": "initial",
      "user_label": "In review",
      "lozenge": "neutral",
      "description": "Created from a submitted recommendation. Deterministic Tier 1 evaluates RecipientClass, BenefitAndPurposeGate, related-party block, supporting-org certification, deep-review currency, IRS-status observation, sanctions and routing."
    },
    {
      "id": "GrantHeldForReview",
      "kind": "intermediate",
      "user_label": "On hold – review",
      "lozenge": "attention",
      "description": "Gate outcome Hold (benefit or purpose, missing supporting-org certification, deep review expired, status Unknown, potential sanctions match, counsel review). A WorkItem names the exit condition."
    },
    {
      "id": "GrantRelatedPartyHold",
      "kind": "intermediate",
      "user_label": "Blocked – related party",
      "lozenge": "blocked",
      "description": "Payee, destination owner or declared beneficiary matches the fund's related-party registry. Nonwaivable; only independent compliance on counsel's determination releases."
    },
    {
      "id": "GrantApproveRecommended",
      "kind": "intermediate",
      "user_label": "Approval recommended",
      "lozenge": "attention",
      "description": "RCD-005 current path: the deterministic tier's outcome is ApproveRecommended; a human approves in one-click batches (A4)."
    },
    {
      "id": "GrantAwaitingHumanApproval",
      "kind": "intermediate",
      "user_label": "Awaiting approval",
      "lozenge": "attention",
      "description": "Routing matrix (role, amount, risk, relationship, exception) requires an individual human decision, with dual control where policy requires."
    },
    {
      "id": "GrantCapacityShort",
      "kind": "intermediate",
      "user_label": "Waiting for funds",
      "lozenge": "attention",
      "description": "Approval failed because authoritative capacity was insufficient in the approval transaction. Not approved; nothing reserved."
    },
    {
      "id": "GrantReserved",
      "kind": "intermediate",
      "user_label": "Approved",
      "lozenge": "neutral",
      "description": "Approved and reserved in one serialisable transaction against every constrained ancestor; amount fixed (percentage grants fix here)."
    },
    {
      "id": "GrantFundingPlanned",
      "kind": "intermediate",
      "user_label": "Funding planned",
      "lozenge": "neutral",
      "description": "Funding source chosen: pool cash buffer first; liquidation if the buffer cannot cover. Equivalent to RR-REQ-X-002-r1 ApprovedPendingLiquidity when liquidation is needed. No external commitment."
    },
    {
      "id": "GrantLiquidationPending",
      "kind": "intermediate",
      "user_label": "Selling investments",
      "lozenge": "neutral",
      "description": "Redemption or sale submitted to the custodian/pool; awaiting settlement."
    },
    {
      "id": "GrantFundingShortfall",
      "kind": "intermediate",
      "user_label": "Funding shortfall",
      "lozenge": "attention",
      "description": "A source could not deliver (redemption gate, NAV drop beyond haircut). Sponsor shortfall rule applies; never draws on other grants' reservations."
    },
    {
      "id": "GrantFunded",
      "kind": "intermediate",
      "user_label": "Funded – ready to pay",
      "lozenge": "neutral",
      "description": "Settled, unencumbered cash equal to the fixed amount is allocated in the paying account (or an approved liquidity advance)."
    },
    {
      "id": "GrantCancellationRequested",
      "kind": "intermediate",
      "user_label": "Cancellation requested",
      "lozenge": "attention",
      "description": "Requester asked to cancel after approval; payment release is paused until the sponsor decides (GR-9)."
    },
    {
      "id": "GrantDeathReviewHold",
      "kind": "intermediate",
      "user_label": "On hold – authority review",
      "lozenge": "attention",
      "description": "Approved unpaid grant after verified death of the recommender where the sponsor's death_pending_grant_policy is hold_for_review."
    },
    {
      "id": "GrantPaymentInProgress",
      "kind": "intermediate",
      "user_label": "Payment in progress",
      "lozenge": "neutral",
      "description": "A payment chain (WFM-10 ACH or WFM-11 check) is live. Grant state is derived from attempts; finality is a fact, not a guess."
    },
    {
      "id": "GrantReturnedPendingDecision",
      "kind": "intermediate",
      "user_label": "Payment returned",
      "lozenge": "attention",
      "description": "Payment returned, recalled, voided-and-recredited or not received; funds re-credited to the originating fund by a linked compensating entry; sponsor decides re-pay or cancel."
    },
    {
      "id": "GrantBlocked",
      "kind": "intermediate",
      "user_label": "Blocked",
      "lozenge": "blocked",
      "description": "Confirmed sanctions true match on property in the sponsor's possession (WFM-12). No movement, retry, reissue or capacity restoration."
    },
    {
      "id": "GrantPaid",
      "kind": "terminal",
      "user_label": "Paid",
      "lozenge": "ok",
      "description": "Cumulative settled equals the grant amount and Final(rail) holds; reservation consumed."
    },
    {
      "id": "GrantDeclined",
      "kind": "terminal",
      "user_label": "Declined",
      "lozenge": "neutral",
      "description": "Sponsor declined (rule or human) with an explanation; reconsideration via UNB-RCN-ENT-016."
    },
    {
      "id": "GrantWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Recommendation withdrawn or superseded before decision (same operation)."
    },
    {
      "id": "GrantCanceled",
      "kind": "terminal",
      "user_label": "Canceled",
      "lozenge": "neutral",
      "description": "Canceled after approval (sponsor decision, recipient decline, shortfall); reservation released with reason."
    },
    {
      "id": "GrantPaymentCorrection",
      "kind": "correction",
      "user_label": "Corrected",
      "lozenge": "neutral",
      "description": "Linked correction child after Paid (late return, misdirected payment recovery, post-payment adverse finding). Parent unchanged."
    }
  ],
