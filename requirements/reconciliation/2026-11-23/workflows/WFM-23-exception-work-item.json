{
  "workflow_id": "WFM-23",
  "name": "Rule-created exception work item",
  "release": "R1",
  "outcome": "A work item exists only when a deterministic process cannot complete; it closes automatically when its exit condition is met, escalates on SLA breach, and is decided only by an authorized human who is not its preparer",
  "aggregate": "WorkItem",
  "sources": [
    "RR-REQ-X-048-r1",
    "UNB-RCN-PLT-006",
    "REQ-X-049",
    "REQ-X-017",
    "ADM-016",
    "ADM-031",
    "ADM-033",
    "19-questions/HUMAN-WORK-QUEUES-ROUTING-OWNERSHIP-AND-CASE-CONTINUITY-2026-11-23.md:29",
    "06-state-models/state-models.md#8 (FLAG-1)"
  ],
  "observer_surfaces": [
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "WorkItemOpen",
      "kind": "initial",
      "user_label": "Open",
      "lozenge": "attention",
      "description": "Created by a rule with blocked-outcome reference, creating rule, exit condition and SLA."
    },
    {
      "id": "WorkItemAssigned",
      "kind": "intermediate",
      "user_label": "Assigned",
      "lozenge": "attention",
      "description": "Routed by the sponsor routing policy (round robin, sticky owner, skill, capacity, hybrid) to an assignee."
    },
    {
      "id": "WorkItemInReview",
      "kind": "intermediate",
      "user_label": "In review",
      "lozenge": "attention",
      "description": "Claimed by one assignee who gathers evidence and prepares a decision."
    },
    {
      "id": "WorkItemWaitingExternal",
      "kind": "intermediate",
      "user_label": "Waiting on others",
      "lozenge": "attention",
      "description": "Evidence requested from a donor, charity, provider or other external party."
    },
    {
      "id": "WorkItemEscalated",
      "kind": "intermediate",
      "user_label": "Escalated",
      "lozenge": "attention",
      "description": "SLA breached or authority beyond the assignee's; supervisor notified."
    },
    {
      "id": "WorkItemDecisionProposed",
      "kind": "intermediate",
      "user_label": "Decision proposed",
      "lozenge": "attention",
      "description": "Preparer proposed a decision with evidence snapshot; waiting for an authorized decider."
    },
    {
      "id": "WorkItemDecisionRecorded",
      "kind": "intermediate",
      "user_label": "Decision recorded",
      "lozenge": "attention",
      "description": "Decision record written; command issued to the subject aggregate; waiting for the subject to reach its exit state."
    },
    {
      "id": "WorkItemReopened",
      "kind": "intermediate",
      "user_label": "Reopened",
      "lozenge": "attention",
      "description": "Decision could not be executed (stale revision, changed evidence) or the subject left its exit state; returns to routing."
    },
    {
      "id": "WorkItemClosed",
      "kind": "terminal",
      "user_label": "Closed",
      "lozenge": "ok",
      "description": "Subject reached the exit condition after a human decision."
    },
    {
      "id": "WorkItemAutoClosed",
      "kind": "terminal",
      "user_label": "Closed automatically",
      "lozenge": "ok",
      "description": "Exit condition met by system events without a human decision."
    },
    {
      "id": "WorkItemCancelled",
      "kind": "terminal",
      "user_label": "Cancelled",
      "lozenge": "neutral",
      "description": "Subject withdrawn or superseded; item no longer needed."
    },
    {
      "id": "WorkItemFollowUp",
      "kind": "correction",
      "user_label": "Follow-up item linked",
      "lozenge": "neutral",
      "description": "Same condition recurred on new evidence after closure: a new linked item is raised; the closed item is unchanged."
    }
  ],
