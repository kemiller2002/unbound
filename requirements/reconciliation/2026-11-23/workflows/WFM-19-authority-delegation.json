{
  "workflow_id": "WFM-19",
  "name": "Delegated authority: grant, change scope, revalidate, revoke and expire",
  "release": "R1",
  "outcome": "Every advisor, legal representative and delegated agent principal acts only through an explicit, scoped, effective-dated role grant whose revocation or expiry takes effect at the next authorization check and holds pending work it produced",
  "aggregate": "RoleGrant",
  "sources": [
    "RR-UNB-ADV-001-r1",
    "RR-UNB-PART-003-r1",
    "UNB-RCN-PLT-005",
    "UNB-RCN-ENT-010",
    "GOV-AUTH-015",
    "TX-25",
    "06-state-models/state-models.md#7 (AUTH-I1, AUTH-I2, AUTH-I3, AUTH-I7)",
    "E2E-WF-18"
  ],
  "observer_surfaces": [
    "UNB-UI-S-006",
    "UNB-UI-S-001"
  ],
  "states": [
    {
      "id": "DelegationRequested",
      "kind": "initial",
      "user_label": "Requested",
      "lozenge": "attention",
      "description": "Grantor (advisory-privilege holder, representative principal or sponsor) requested a role grant for an advisor, legal representative or agent principal with scope (fund set, command set, amount limits) and effective dates."
    },
    {
      "id": "DelegationEvidencePending",
      "kind": "intermediate",
      "user_label": "Awaiting documents",
      "lozenge": "attention",
      "description": "Legal-representative subtype requires an instrument (power of attorney, guardianship order, letters testamentary, trust certificate, entity resolution)."
    },
    {
      "id": "DelegationEvidenceReview",
      "kind": "intermediate",
      "user_label": "Documents in review",
      "lozenge": "attention",
      "description": "Sponsor reviewer verifies the instrument, its scope and its expiry."
    },
    {
      "id": "DelegateVerifying",
      "kind": "intermediate",
      "user_label": "Verifying delegate",
      "lozenge": "attention",
      "description": "Delegate acceptance, identity proofing where the regime register requires it, and sanctions screening."
    },
    {
      "id": "DelegateVerificationUnknown",
      "kind": "intermediate",
      "user_label": "Verification result unknown",
      "lozenge": "unknown",
      "description": "Identity or sanctions provider returned no definite result; grant not active."
    },
    {
      "id": "DelegatePotentialMatch",
      "kind": "intermediate",
      "user_label": "Delegate under review",
      "lozenge": "blocked",
      "description": "Potential sanctions match or identity conflict held for compliance disposition."
    },
    {
      "id": "DelegationActive",
      "kind": "intermediate",
      "user_label": "Active",
      "lozenge": "ok",
      "description": "Grant in force with an authority version; every command is checked against it."
    },
    {
      "id": "DelegationScopeChangePending",
      "kind": "intermediate",
      "user_label": "Scope change pending",
      "lozenge": "attention",
      "description": "Grantor asked to widen scope; step-up and re-verification apply before the wider scope takes effect."
    },
    {
      "id": "DelegationRevalidating",
      "kind": "intermediate",
      "user_label": "Rechecking access",
      "lozenge": "attention",
      "description": "An event (grantor protective hold, role change, sanctions list update, instrument expiry, credential change, partner termination) requires revalidation."
    },
    {
      "id": "DelegationSuspended",
      "kind": "intermediate",
      "user_label": "Suspended",
      "lozenge": "blocked",
      "description": "Grant suspended (parent authority held or revalidation failed); commands denied and pending items held."
    },
    {
      "id": "DelegationRevoked",
      "kind": "terminal",
      "user_label": "Revoked",
      "lozenge": "neutral",
      "description": "Grant ended by grantor or sponsor, or because its parent authority ended."
    },
    {
      "id": "DelegationExpired",
      "kind": "terminal",
      "user_label": "Expired",
      "lozenge": "neutral",
      "description": "Grant reached its effective end date."
    },
    {
      "id": "DelegationRejected",
      "kind": "terminal",
      "user_label": "Not approved",
      "lozenge": "blocked",
      "description": "Evidence rejected, scope exceeded grantor's, identity failed or sanctions match confirmed."
    },
    {
      "id": "DelegationRequestClosed",
      "kind": "terminal",
      "user_label": "Request closed",
      "lozenge": "neutral",
      "description": "Request withdrawn by the grantor, declined by the delegate or lapsed waiting for documents."
    },
    {
      "id": "DelegationActionsReview",
      "kind": "correction",
      "user_label": "Actions under review",
      "lozenge": "neutral",
      "description": "Linked review of actions taken under a grant later found invalid (forged instrument, undisclosed death of principal); no automatic reversal."
    }
  ],
