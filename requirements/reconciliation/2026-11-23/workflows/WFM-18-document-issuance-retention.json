{
  "workflow_id": "WFM-18",
  "name": "Document issuance, delivery and retention",
  "release": "R1",
  "outcome": "Every formally issued document is rendered once from its snapshot, registered with verifiable hashes, delivered with evidence, corrected only by supersession, and retained until an approved, hold-checked disposition",
  "aggregate": "IssuedDocument",
  "sources": [
    "REQ-X-034",
    "RR-REQ-X-036-r1",
    "RCD-007",
    "RCD-009",
    "REQ-X-038"
  ],
  "observer_surfaces": [
    "UNB-UI-S-007",
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "DocumentRequested",
      "kind": "initial",
      "user_label": "Requested",
      "lozenge": "neutral",
      "description": "An issuing module requested a document (acknowledgment, statement, grant confirmation, remittance, notice) with a source snapshot."
    },
    {
      "id": "DocumentRendered",
      "kind": "intermediate",
      "user_label": "Rendered",
      "lozenge": "attention",
      "description": "PDF (headless Chromium from Folio markup) and accessible HTML rendered from one snapshot; validations passed."
    },
    {
      "id": "DocumentIssuanceBlocked",
      "kind": "intermediate",
      "user_label": "Issuance blocked",
      "lozenge": "blocked",
      "description": "Mandatory element missing, template unpublished, accessibility or truncation check failed, or no retention class."
    },
    {
      "id": "DocumentIssuanceUnknown",
      "kind": "intermediate",
      "user_label": "Issuance unknown",
      "lozenge": "unknown",
      "description": "Object store and registry write disagree (bytes without row, or row without bytes)."
    },
    {
      "id": "DocumentIssued",
      "kind": "intermediate",
      "user_label": "Issued",
      "lozenge": "ok",
      "description": "Registry row with PDF hash, snapshot hash and retention class; visible in the document center."
    },
    {
      "id": "DocumentDeliverySent",
      "kind": "intermediate",
      "user_label": "Sent",
      "lozenge": "attention",
      "description": "Handed to the email or print provider; provider acceptance is not delivery."
    },
    {
      "id": "DocumentDeliveryUnknown",
      "kind": "intermediate",
      "user_label": "Delivery unknown",
      "lozenge": "unknown",
      "description": "Provider outcome not determinable; no blind resend."
    },
    {
      "id": "DocumentDeliveryFailed",
      "kind": "intermediate",
      "user_label": "Delivery failed",
      "lozenge": "blocked",
      "description": "Bounce or returned mail."
    },
    {
      "id": "DocumentInRetention",
      "kind": "intermediate",
      "user_label": "In retention",
      "lozenge": "neutral",
      "description": "Issued and delivered (or portal-only); retained under its effective retention."
    },
    {
      "id": "DocumentSupersededInRetention",
      "kind": "intermediate",
      "user_label": "Superseded, retained",
      "lozenge": "neutral",
      "description": "Replaced by a linked corrected or void document; original preserved and retained."
    },
    {
      "id": "DocumentOnLegalHold",
      "kind": "intermediate",
      "user_label": "Legal hold",
      "lozenge": "blocked",
      "description": "A legal hold covers this document; disposition impossible."
    },
    {
      "id": "DocumentEligibleForReview",
      "kind": "intermediate",
      "user_label": "Eligible for disposition review",
      "lozenge": "attention",
      "description": "Effective retention expired; awaiting a class-level disposition batch."
    },
    {
      "id": "DocumentDispositionApproved",
      "kind": "intermediate",
      "user_label": "Disposition approved",
      "lozenge": "attention",
      "description": "Included in an approved class-level batch; awaiting fenced execution."
    },
    {
      "id": "DocumentDispositionUnknown",
      "kind": "intermediate",
      "user_label": "Disposition outcome unknown",
      "lozenge": "unknown",
      "description": "Storage delete outcome not determinable."
    },
    {
      "id": "DocumentDisposed",
      "kind": "terminal",
      "user_label": "Disposed",
      "lozenge": "neutral",
      "description": "Bytes destroyed; registry tombstone with hash, class, batch and approvers kept."
    }
  ],
  "transitions": [
    {
      "id": "WFM-18-T01",
      "from": "DocumentRequested",
      "to": "DocumentRendered",
      "trigger": "command",
      "name": "RenderFromSnapshot",
      "actor_type": "deterministic",
      "actor_role": "Document service (Folio markup, headless Chromium PDF + accessible HTML)",
      "authority": "A3",
      "guards": [
        "template-version-published",
        "mandatory-clauses-present",
        "accessibility-check-passed",
        "no-truncation"
      ],
      "effects": [
        "render"
      ],
      "idempotency_key": "(docType, subjectId, snapshotHash, templateVersion)",
      "failure": [
        {
          "condition": "ValidationFailed",
          "to_state": "DocumentIssuanceBlocked"
        },
        {
          "condition": "TimeoutRenderer",
          "to_state": "DocumentRequested"
        }
      ],
      "requirement_ids": [
        "REQ-X-034",
        "RCD-009",
