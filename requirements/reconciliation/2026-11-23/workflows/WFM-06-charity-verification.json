{
  "workflow_id": "WFM-06",
  "name": "Charity identity, status verification and holds",
  "release": "R1",
  "outcome": "Every grant recipient is a canonical, currently verified excepted public charity, and any adverse fact reaches every affected sponsor before the next approval or release",
  "aggregate": "CharityVerification (common record) with per-sponsor reliance snapshot and sponsor-scoped hold overlay",
  "sources": [
    "RR-REQ-X-007-r1",
    "UNB-RCN-GRT-001",
    "UNB-RCN-GRT-013",
    "UNB-RCN-GRT-014",
    "UNB-RCN-REG-002",
    "RCD-006",
    "RCD-013",
    "RCD-014",
    "RCD-029",
    "RR-REQ-X-020-r1",
    "UNB-RCN-PLT-014",
    "TX-27",
    "WF-03 (completeness audit, charity eligibility)",
    "06-state-models/state-models.md SM-0, SM-6"
  ],
  "observer_surfaces": [
    "UNB-UI-S-002",
    "UNB-UI-S-004",
    "UNB-UI-S-011",
    "UNB-UI-S-012"
  ],
  "states": [
    {
      "id": "CharityIdentityRequested",
      "kind": "initial",
      "user_label": "Identity check requested",
      "lozenge": "neutral",
      "description": "A recipient was referenced for the first time (registry seed or a donor's 'Can't find it?' identity-resolution request from S-002). No grant may bind to free text."
    },
    {
      "id": "CharityIdentityResolutionReview",
      "kind": "intermediate",
      "user_label": "Identity review",
      "lozenge": "attention",
      "description": "Automatic matching found zero or several candidates (same name, alias, EIN conflict). A charity data analyst resolves it."
    },
    {
      "id": "CharityIdentityResolved",
      "kind": "intermediate",
      "user_label": "Identity confirmed",
      "lozenge": "neutral",
      "description": "Canonical identity (legal name, EIN, legal payee, fiscal sponsor/project as separate facts) is bound; status not yet observed."
    },
    {
      "id": "CharityStatusObserving",
      "kind": "intermediate",
      "user_label": "Checking IRS status",
      "lozenge": "neutral",
      "description": "An IRS-status observation (TEOS/Pub 78 or EO BMF plus Auto-Revocation List, latest published revision) is being retrieved."
    },
    {
      "id": "CharityStatusUnknown",
      "kind": "intermediate",
      "user_label": "Status unknown",
      "lozenge": "unknown",
      "description": "The IRS source was unreachable or returned an indeterminate result. Absence or outage is not ineligibility (UNB-RULE-009); approvals and releases that need a fresh observation fail closed."
    },
    {
      "id": "CharityAlternateEvidenceReview",
      "kind": "intermediate",
      "user_label": "Evidence review",
      "lozenge": "attention",
      "description": "Recipient is absent from IRS bulk files (church, government unit, group subordinate, disregarded entity, newly recognised). Evidence is evaluated against the EntityTypeEvidence matrix."
    },
    {
      "id": "CharityClassifying",
      "kind": "intermediate",
      "user_label": "Classifying recipient",
      "lozenge": "neutral",
      "description": "Deterministic RecipientClass rule (counsel-approved, versioned) maps the observation to Permitted, ERRequired, Prohibited or CounselReview."
    },
    {
      "id": "CharityRecipientClassCounselReview",
      "kind": "intermediate",
      "user_label": "Counsel review",
      "lozenge": "attention",
      "description": "The class rule returned CounselReview. Counsel decides; AI output may not set a class."
    },
    {
      "id": "CharitySupportingOrgCertPending",
      "kind": "intermediate",
      "user_label": "Certification needed",
      "lozenge": "attention",
      "description": "Type I, Type II or functionally integrated Type III supporting organisation without a current donor-control certification. New approvals are held (UNB-RCN-REG-002)."
    },
    {
      "id": "CharityVerified",
      "kind": "intermediate",
      "user_label": "Eligible",
      "lozenge": "ok",
      "description": "Common verification status Eligible; deep review current; daily IRS-status observation current. Each sponsor's reliance snapshot is written to that sponsor's partition at approval and at release."
    },
    {
      "id": "CharityRefreshInProgress",
      "kind": "intermediate",
      "user_label": "Eligible – review refreshing",
      "lozenge": "ok",
      "description": "Automatic deep-review refresh started at the FreshnessPolicy lead time (default 30 days before the 180-day expiry) or on a material-change signal. Charity remains Eligible."
    },
    {
      "id": "CharityDeepReviewEscalated",
      "kind": "intermediate",
      "user_label": "Review needed",
      "lozenge": "attention",
      "description": "The refresh found conflicting or incomplete evidence that rules cannot settle. A work item exists; charity remains Eligible until the deep review expires."
    },
    {
      "id": "CharityDeepReviewExpired",
      "kind": "intermediate",
      "user_label": "Review overdue",
      "lozenge": "attention",
      "description": "Deep review passed its maximum age without a passing refresh. New approvals are held; payment-time eligibility still relies on the IRS-status check, not on this expiry (RR-REQ-X-007-r1)."
    },
    {
      "id": "CharitySponsorHold",
      "kind": "intermediate",
      "user_label": "On hold (this sponsor)",
      "lozenge": "blocked",
      "description": "Sponsor-scoped hold from a sponsor-private investigation. Never propagated to other sponsors (RCD-029); other sponsors see nothing."
    },
    {
      "id": "CharityHeldAdverse",
      "kind": "intermediate",
      "user_label": "On hold",
      "lozenge": "blocked",
      "description": "Global hold published in the hold registry with a new HoldPublicationVersion, from verified public-source (E0/E1) evidence or independent compliance authority. Propagated to every affected sponsor as a reason class and date only."
    },
    {
      "id": "CharityIneligible",
      "kind": "terminal",
      "user_label": "Not eligible",
      "lozenge": "blocked",
      "description": "Recipient is not a permitted release-1 recipient (revoked, private foundation, NFI Type III, foreign, natural person, non-charitable) or adverse status confirmed. Reinstatement starts a new verification record."
    },
    {
      "id": "CharityNotVerified",
      "kind": "terminal",
      "user_label": "Could not verify",
      "lozenge": "neutral",
      "description": "Identity-resolution request rejected or evidence never supplied. Not an adverse finding."
    },
    {
      "id": "CharityStatusCorrection",
      "kind": "correction",
      "user_label": "Status corrected",
      "lozenge": "neutral",
      "description": "Linked correction child (erroneous determination, retroactive IRS reinstatement). The original determination and every reliance snapshot stay unchanged."
    }
  ],
