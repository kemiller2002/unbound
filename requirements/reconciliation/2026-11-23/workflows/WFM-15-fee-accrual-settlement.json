      "name": "RequestFeeWaiver",
      "actor_type": "human",
      "actor_role": "Sponsor relationship manager",
      "authority": "A2",
      "guards": [],
      "effects": [
        "work-item"
      ],
      "idempotency_key": "(fundId, period, requestId)",
      "failure": [],
