{
  "workflow_id": "WFM-15",
  "name": "Fee accrual and settlement",
  "release": "R1",
  "outcome": "Each fund is charged exactly the contracted fee on a declared, recomputable base, settled monthly, with waivers and shortfalls decided by independent humans",
  "aggregate": "FeePeriod",
  "sources": [
    "UNB-RCN-FIN-005",
    "RR-UNB-NAV-033-r1",
    "RCD-018",
    "TX-20"
  ],
  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "FeePeriodAccruing",
      "kind": "initial",
      "user_label": "Accruing",
      "lozenge": "neutral",
      "description": "Fee period open for one fund; daily accruals on the declared FeeBase."
    },
    {
      "id": "FeeAccrualHeld",
      "kind": "intermediate",
      "user_label": "Accrual held",
      "lozenge": "blocked",
      "description": "FeeBase undeclared or invalid, valuation not approved, advisor relationship unclassified, or fund frozen."
    },
    {
      "id": "FeePeriodAccrued",
      "kind": "intermediate",
      "user_label": "Accrued, awaiting settlement",
      "lozenge": "attention",
      "description": "Period ended (month end or closure); accruals final for the period."
    },
    {
      "id": "FeeWaiverRequested",
      "kind": "intermediate",
      "user_label": "Waiver requested",
      "lozenge": "attention",
      "description": "A waiver of the accrued period fee awaits an independent decision."
    },
    {
      "id": "FeeSettlementCalculated",
      "kind": "intermediate",
      "user_label": "Settlement calculated",
      "lozenge": "attention",
      "description": "Accruals summed, minimum fee applied, recipient type resolved."
    },
    {
      "id": "FeeCapacityShortfall",
      "kind": "intermediate",
      "user_label": "Fee exceeds available capacity",
      "lozenge": "blocked",
      "description": "Settlement exceeds the fund's available capacity (e.g. minimum fee with a fully reserved grant)."
    },
    {
      "id": "FeeSettled",
      "kind": "terminal",
      "user_label": "Settled",
      "lozenge": "ok",
      "description": "Fee charged to the fund and recognized as sponsor revenue."
    },
    {
      "id": "FeeWaived",
      "kind": "terminal",
      "user_label": "Waived",
      "lozenge": "neutral",
      "description": "Period fee waived by an independent approver; accruals reversed with linked entries."
    },
    {
      "id": "FeeSettlementCorrected",
      "kind": "correction",
      "user_label": "Corrected",
      "lozenge": "neutral",
      "description": "Linked correction after a NAV restatement or FeeBase error; current-period adjustment."
    }
  ],
  "transitions": [
    {
      "id": "WFM-15-T01",
      "from": "FeePeriodAccruing",
      "to": "FeePeriodAccruing",
      "trigger": "timer",
      "name": "AccrueDailyFee",
      "actor_type": "timer",
      "actor_role": "Fee engine (daily, actual/365)",
      "authority": "A3",
      "guards": [
        "feebase-declared",
        "valuation-approved",
        "no-fee-on-fee",
        "no-duplicate-service-fee",
        "advisor-relationship-classified"
      ],
      "effects": [
        "ledger"
      ],
      "idempotency_key": "(fundId, feeScheduleVersion, accrualDate)",
      "failure": [
        {
          "condition": "FeeBaseOrValuationInvalid",
          "to_state": "FeeAccrualHeld"
        },
        {
          "condition": "AdvisorRelationshipUnclassified",
          "to_state": "FeeAccrualHeld"
        },
        {
          "condition": "FundFrozen",
          "to_state": "FeeAccrualHeld"
        }
      ],
      "requirement_ids": [
        "UNB-RCN-FIN-005",
        "RCD-018",
        "RR-UNB-NAV-033-r1"
      ],
      "scenario_ids": [
        "DKS-FIN-007",
        "DKS-FIN-008",
        "DKS-FIN-021",
        "TVS-347",
        "ADV-041"
      ],
      "notes": "Base = end-of-day fund market value incl. reserved-unpaid, excl. fees embedded in pool NAV and accrued unpaid fees. Stored base makes each accrual recomputable."
    },
    {
      "id": "WFM-15-T02",
      "from": "FeeAccrualHeld",
      "to": "FeePeriodAccruing",
      "trigger": "command",
      "name": "ResolveAccrualHold",
      "actor_type": "human",
      "actor_role": "Fee accountant",
      "authority": "A4",
      "guards": [
        "hold-reason-dispositioned",
        "segregation-of-duties"
      ],
      "effects": [
        "ledger"
      ],
      "idempotency_key": "(fundId, holdId)",
      "failure": [],
      "requirement_ids": [
        "UNB-RCN-FIN-005",
        "RCD-018",
        "RR-UNB-NAV-033-r1",
        "UNB-RCN-FIN-010",
        "RCD-021"
      ],
      "scenario_ids": [
        "DKS-FIN-021"
      ],
      "ui_surface": "UNB-UI-S-009",
      "notes": "Missed days are caught up deterministically from the stored FeeBase on release."
    },
    {
      "id": "WFM-15-T03",
      "from": "FeePeriodAccruing",
      "to": "FeePeriodAccrued",
      "trigger": "timer",
      "name": "CloseAccrualPeriod",
      "actor_type": "timer",
      "actor_role": "Fee engine (month end)",
      "authority": "A3",
      "guards": [],
