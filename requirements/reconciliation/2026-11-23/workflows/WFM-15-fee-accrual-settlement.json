        "RR-UNB-NAV-033-r1"
      ],
      "scenario_ids": []
    },
    {
      "id": "WFM-15-T04",
      "from": "FeePeriodAccruing",
      "to": "FeePeriodAccrued",
      "trigger": "event",
      "name": "CloseAccrualPeriodOnFundClosure",
      "actor_type": "deterministic",
      "actor_role": "Fund closure workflow (FinalFeesPosted step)",
      "authority": "A3",
      "guards": [],
      "effects": [
        "record-period"
      ],
      "idempotency_key": "(fundId, closureId)",
      "failure": [],
      "requirement_ids": [
