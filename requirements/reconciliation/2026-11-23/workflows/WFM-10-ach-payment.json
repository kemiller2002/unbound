  ],
  "states": [
    {
      "id": "AchPaymentPrepared",
      "kind": "initial",
      "user_label": "Preparing payment",
      "lozenge": "neutral",
      "description": "Instruction created from a Funded grant with destination version, reservation version and policy version pinned."
    },
    {
      "id": "AchReleaseBlocked",
      "kind": "intermediate",
      "user_label": "Release blocked",
      "lozenge": "blocked",
      "description": "A release gate failed: hold watermark behind or registry unreachable, eligibility observation stale, potential sanctions match, destination evidence below the rail minimum or destination correction pending. Never dispatched from here."
    },
    {
      "id": "AchReleaseAuthorized",
      "kind": "intermediate",
      "user_label": "Release authorized",
      "lozenge": "neutral",
      "description": "AuthorizePayment committed; the observed HoldPublicationVersion and per-sponsor eligibility snapshot are recorded on the release."
    },
    {
      "id": "AchSubmitted",
      "kind": "intermediate",
      "user_label": "Sent to bank partner",
      "lozenge": "neutral",
      "description": "Dispatch=SentWithRequestId through the outbox with the provider idempotency key. Not paid."
    },
    {
      "id": "AchPaymentUnknown",
      "kind": "intermediate",
      "user_label": "Status unknown",
      "lozenge": "unknown",
      "description": "Dispatch or provider outcome Unknown (timeout, ambiguous response). New dispatch, reissue and settlement posting are blocked for the chain; resolved only through the UnknownResolutionProtocol."
    },
    {
      "id": "AchAccepted",
      "kind": "intermediate",
      "user_label": "Accepted by bank partner",
      "lozenge": "neutral",
      "description": "ProviderKnowledge=Acknowledged/InProcessing. Acknowledged never means settled."
    },
    {
      "id": "AchRecallRequested",
      "kind": "intermediate",
      "user_label": "Recall requested",
      "lozenge": "unknown",
      "description": "Adverse common-status, sanctions or authority event after dispatch and before settlement; stop/recall requested and its outcome is externally uncertain."
    },
    {
      "id": "AchSettled",
      "kind": "intermediate",
      "user_label": "Payment sent",
      "lozenge": "ok",
      "description": "Settlement confirmed with rail proof and posted by the single ledger writer; the rail's return window is still open."
    },
    {
      "id": "AchBlocked",
      "kind": "intermediate",
      "user_label": "Blocked",
      "lozenge": "blocked",
      "description": "Sponsor-side confirmed true match or an intermediary/provider blocking notice. BlockedProperty in the ledger; no retry, reissue or capacity restoration."
    },
    {
      "id": "AchFinal",
      "kind": "terminal",
      "user_label": "Paid",
      "lozenge": "ok",
      "description": "Return window elapsed and ledger, bank and provider reconciled."
    },
    {
      "id": "AchReturned",
      "kind": "terminal",
      "user_label": "Returned",
      "lozenge": "attention",
      "description": "ACH return (R-code) or funds returned under licence; re-credited to the originating fund by a linked compensating entry (grant decides re-pay)."
    },
    {
      "id": "AchRecalled",
      "kind": "terminal",
      "user_label": "Recalled",
      "lozenge": "neutral",
      "description": "Recall confirmed; funds re-credited to the originating fund."
    },
    {
      "id": "AchNotPaid",
      "kind": "terminal",
      "user_label": "Not paid",
      "lozenge": "neutral",
      "description": "Rejected before execution or failed before settlement; funds never left. Grant keeps its reservation."
    },
    {
      "id": "AchNotReceived",
      "kind": "terminal",
      "user_label": "Not received – replacement created",
      "lozenge": "neutral",
      "description": "NotReceived declared under the protocol's evidence combination with independent approval; a linked reissue chain was created."
    },
    {
      "id": "AchAbandoned",
      "kind": "terminal",
      "user_label": "Canceled before sending",
      "lozenge": "neutral",
      "description": "Grant canceled or chain abandoned before dispatch (GR-3)."
    },
    {
      "id": "AchPaymentCorrection",
      "kind": "correction",
      "user_label": "Under correction",
      "lozenge": "attention",
      "description": "Linked correction child: settlement evidence contradicting a terminal outcome (double-payment case, PA-6) or a late return after Final."
    }
  ],
