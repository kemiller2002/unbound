{
  "workflow_id": "WFM-10",
  "name": "ACH grant payment via partner rail",
  "release": "R1",
  "outcome": "Each funded grant installment is paid at most once to its pinned, verified destination, and every uncertain, returned, recalled or blocked outcome is resolved with evidence",
  "aggregate": "PaymentAttempt (headline projection of the six RR-REQ-X-083-r1 dimensions plus WorkCase)",
  "sources": [
    "RR-REQ-X-083-r1",
    "RR-REQ-X-004-r1",
