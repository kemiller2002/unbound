{
  "workflow_id": "WFM-05",
  "name": "Complex asset via partner intermediary (cash delivered)",
  "release": "R1",
  "outcome": "A complex asset is screened (including §4943), handed to the partner intermediary, and only its final cash proceeds ever become grantable",
  "aggregate": "ComplexGiftReferral",
  "sources": [
    "RCD-013",
    "RCD-011",
    "UNB-RCN-FIN-004",
    "RR-UNB-INV-012-r1",
    "REQ-X-059",
    "TX-06",
    "TX-07",
    "TX-08",
    "TX-09"
  ],
  "observer_surfaces": [
    "UNB-UI-S-005",
    "UNB-UI-S-001"
  ],
  "states": [
    {
      "id": "ComplexGiftInquiry",
      "kind": "initial",
      "user_label": "Inquiry",
      "lozenge": "neutral",
      "description": "Donor indicates a complex asset (private stock, LP interest, real estate, crypto)."
    },
    {
      "id": "ComplexGiftScreening",
      "kind": "intermediate",
      "user_label": "Sponsor screening",
      "lozenge": "attention",
      "description": "Asset classification, sanctions, source-of-funds and §4943 combined-holdings test."
    },
    {
      "id": "ComplexGiftScreeningHold",
      "kind": "intermediate",
      "user_label": "Held for review",
      "lozenge": "blocked",
      "description": "Potential sanctions match, source-of-funds review, or missing related-person holdings data."
    },
    {
      "id": "ComplexGiftEbhReview",
      "kind": "intermediate",
      "user_label": "Excess business holdings review",
      "lozenge": "blocked",
      "description": "Combined holdings of fund, donors, advisors and related persons exceed or cannot be computed against counsel-configured limits."
    },
    {
      "id": "ComplexGiftClearedForReferral",
      "kind": "intermediate",
      "user_label": "Cleared for referral",
      "lozenge": "attention",
      "description": "Sponsor screening passed; referral may be sent."
    },
    {
      "id": "ComplexGiftReferred",
      "kind": "intermediate",
      "user_label": "Referred to intermediary",
      "lozenge": "attention",
      "description": "Referral sent to the partner intermediary; awaiting its decision."
    },
    {
      "id": "ComplexGiftReferralUnknown",
      "kind": "intermediate",
      "user_label": "Referral status unknown",
      "lozenge": "unknown",
      "description": "Intermediary did not confirm receipt of the referral or did not answer in time."
    },
    {
      "id": "ComplexGiftIntermediaryAccepted",
      "kind": "intermediate",
      "user_label": "Intermediary accepted",
      "lozenge": "attention",
      "description": "Intermediary accepted the asset under its own gift acceptance; asset not yet transferred."
    },
    {
      "id": "ComplexGiftLiquidating",
      "kind": "intermediate",
      "user_label": "Intermediary liquidating",
      "lozenge": "attention",
      "description": "Asset transferred to the intermediary; sale in progress. No sponsor capacity."
    },
    {
      "id": "ComplexGiftProceedsOverdue",
      "kind": "intermediate",
      "user_label": "Proceeds overdue",
      "lozenge": "unknown",
      "description": "Expected proceeds not received within the agreed period."
    },
    {
      "id": "ComplexGiftProceedsReceived",
      "kind": "intermediate",
      "user_label": "Proceeds received",
      "lozenge": "attention",
      "description": "Cash from the intermediary received and matched to the referral; clearing entry posted."
    },
    {
      "id": "ComplexGiftProceedsFinal",
      "kind": "intermediate",
      "user_label": "Proceeds final",
      "lozenge": "ok",
      "description": "Proceeds final (wire) and credited to grantable capacity."
    },
    {
      "id": "ComplexGiftComplete",
      "kind": "terminal",
      "user_label": "Complete",
      "lozenge": "ok",
      "description": "Proceeds credited; acknowledgment issued or inbound charitable transfer recorded per structure."
    },
    {
      "id": "ComplexGiftDeclinedBySponsor",
      "kind": "terminal",
      "user_label": "Declined by sponsor",
      "lozenge": "blocked",
      "description": "Sponsor declined (e.g. excess business holdings, source of funds)."
    },
    {
      "id": "ComplexGiftDeclinedByIntermediary",
      "kind": "terminal",
      "user_label": "Declined by intermediary",
      "lozenge": "neutral",
      "description": "Intermediary declined the asset."
    },
    {
      "id": "ComplexGiftBlocked",
      "kind": "terminal",
      "user_label": "Blocked (sanctions)",
      "lozenge": "blocked",
      "description": "Confirmed sanctions match on a party."
    },
    {
      "id": "ComplexGiftWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Donor withdrew before transferring the asset."
    },
    {
      "id": "ComplexGiftAbandoned",
      "kind": "terminal",
      "user_label": "Abandoned",
      "lozenge": "neutral",
      "description": "Intermediary could not sell; asset disposed of under the intermediary's terms; no proceeds."
    },
    {
      "id": "ComplexGiftCorrected",
      "kind": "correction",
      "user_label": "Corrected",
      "lozenge": "neutral",
      "description": "Linked correction (intermediary restates proceeds or fees); original preserved."
    }
  ],
