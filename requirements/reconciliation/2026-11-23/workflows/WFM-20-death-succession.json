{
  "workflow_id": "WFM-20",
  "name": "Death or incapacity notice, rights suspension and succession",
  "release": "R1",
  "outcome": "On any notice the subject's derived rights are held; on verified evidence they are suspended atomically (including delegated agents); successors gain rights only after identity proofing and an A4 sponsor activation with a balanced allocation; if no successor exists the program's charitable default applies",
  "aggregate": "SuccessionCase",
  "sources": [
    "RR-UNB-SUCC-008-r1",
    "UNB-RCN-ENT-004",
    "RCD-022",
    "RR-REQ-X-008-r1",
    "RR-UNB-SUCC-004-r1",
    "UNB-SUCC-007",
    "UNB-SUCC-011",
    "OD-03",
    "06-state-models/state-models.md#7 (AUTH-I3, AUTH-I5)",
    "TX-25",
    "E2E-WF-18"
  ],
  "observer_surfaces": [
    "UNB-UI-S-006",
    "UNB-UI-S-001",
    "UNB-UI-S-004"
  ],
  "states": [
    {
      "id": "SuccessionNoticeReceived",
      "kind": "initial",
      "user_label": "Notice received",
      "lozenge": "attention",
      "description": "A death or incapacity notice about a subject party was received from any channel, authenticated or not."
    },
    {
      "id": "SuccessionProtectiveHold",
      "kind": "intermediate",
      "user_label": "Protective hold",
      "lozenge": "blocked",
      "description": "New recommendations, recurring-instance releases and contact/payee changes for rights derived from the subject are blocked; subject notified on verified channel."
    },
    {
      "id": "SuccessionVerifying",
      "kind": "intermediate",
      "user_label": "Verifying notice",
      "lozenge": "attention",
      "description": "Evidence (death certificate, court order, physician statement per policy) requested and under review."
    },
    {
      "id": "SuccessionDerivedRightsSuspended",
      "kind": "intermediate",
      "user_label": "Rights suspended",
      "lozenge": "blocked",
      "description": "Every session, credential binding, delegated agent principal and privilege derived from the subject is suspended in one transaction."
    },
    {
      "id": "SuccessionPlanResolving",
      "kind": "intermediate",
      "user_label": "Determining successors",
      "lozenge": "attention",
      "description": "Pending-item policy applied; succession plan read; designated, contingent or substitute successors identified."
    },
    {
      "id": "SuccessorIdentityProofing",
      "kind": "intermediate",
      "user_label": "Verifying successors",
      "lozenge": "attention",
      "description": "Successor-designates accept and pass identity proofing and sanctions screening (RCD-023)."
    },
    {
      "id": "SuccessorVerificationUnknown",
      "kind": "intermediate",
      "user_label": "Successor check unknown",
      "lozenge": "unknown",
      "description": "Provider returned no definite result for a successor."
    },
    {
      "id": "SuccessorVerificationHeld",
      "kind": "intermediate",
      "user_label": "Successor check held",
      "lozenge": "blocked",
      "description": "Potential sanctions match, identity failure or ineligibility (minor, incapacitated) needs a human disposition."
    },
    {
      "id": "SuccessionContested",
      "kind": "intermediate",
      "user_label": "Contested",
      "lozenge": "blocked",
      "description": "Conflicting claims or documents; all consequential succession actions held pending sponsor/legal resolution."
    },
    {
      "id": "SuccessionAllocationProposed",
      "kind": "intermediate",
      "user_label": "Allocation proposed",
      "lozenge": "attention",
      "description": "Deterministic allocation preview computed at the sponsor-designated valuation point, net of reservations, accrued fees and approved-unpaid grants."
    },
    {
      "id": "SuccessionSplitHeld",
      "kind": "intermediate",
      "user_label": "Split held",
      "lozenge": "blocked",
      "description": "A constraint (minimum, restriction, illiquidity, open commitment) cannot be met; no journal posted."
    },
    {
      "id": "SuccessionCharitableDefaultPending",
      "kind": "intermediate",
      "user_label": "Charitable default pending",
      "lozenge": "attention",
      "description": "No eligible successor; program terms name a charitable default awaiting A4 sponsor approval."
    },
    {
      "id": "SuccessionActivated",
      "kind": "terminal",
      "user_label": "Succession active",
      "lozenge": "ok",
      "description": "Successor rights granted and allocation journal posted atomically; successor accounts created where the plan requires."
    },
    {
      "id": "SuccessionCharitableDefaultApproved",
      "kind": "terminal",
      "user_label": "Charitable default approved",
      "lozenge": "ok",
      "description": "Sponsor approved the charitable default; distributions proceed as grants through the standard grant lifecycle, then the fund closes (WFM-22)."
    },
    {
      "id": "SuccessionNotRequired",
      "kind": "terminal",
      "user_label": "No succession needed",
      "lozenge": "neutral",
      "description": "Independent co-advisors continue under the plan; only the subject's own rights ended."
    },
    {
      "id": "SuccessionRightsReinstated",
      "kind": "terminal",
      "user_label": "Rights reinstated",
      "lozenge": "ok",
      "description": "Notice proven false or incapacity ended; RightsReinstated appended, original hold kept in history."
    },
    {
      "id": "SuccessionCorrection",
      "kind": "correction",
      "user_label": "Succession corrected",
      "lozenge": "neutral",
      "description": "Linked correction (e.g. later valid amendment, forged evidence); paid grants are never reversed automatically; any change is a new sponsor decision."
    }
  ],
