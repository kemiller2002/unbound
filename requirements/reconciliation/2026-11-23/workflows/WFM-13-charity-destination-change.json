      "actor_role": "Charity officer (authenticated, role-verified)",
      "authority": "A2",
      "guards": [
        "requester-role-verified"
      ],
      "effects": [
        "create-destination-version",
        "notify-previous-channel"
      ],
      "idempotency_key": "(charityId, requestId)",
      "failure": [],
