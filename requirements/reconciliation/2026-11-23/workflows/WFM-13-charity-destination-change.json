{
  "workflow_id": "WFM-13",
  "name": "Charity payment destination change",
  "release": "R1",
  "outcome": "A charity's new bank destination becomes usable only after DestinationEvidence meeting the rail minimum and an independent callback, while authorized payments stay pinned to the previous verified destination",
  "aggregate": "PayeeDestinationVersion",
  "sources": [
    "RR-REQ-X-005-r1",
    "UNB-RCN-GRT-017",
    "UNB-UI-S-012",
    "UNB-GEX-018",
    "UNB-CHAR-032",
    "UNB-RCN-GRT-002",
    "UNB-RCN-ENT-016",
    "RCD-028",
    "TX-19",
    "RCF-GRT-018",
    "RCF-GRT-019",
    "PRECISE-PAYMENT-STATE-MACHINE-AND-RAIL-PROOF-CONTRACT-2026-11-23.md invariant 2"
  ],
  "observer_surfaces": [
    "UNB-UI-S-012",
    "UNB-UI-S-008",
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "DestDraft",
      "kind": "initial",
      "user_label": "Draft",
      "lozenge": "neutral",
      "description": "A new destination version is being prepared (charity portal, staff-assisted intake or an ACH NOC)."
    },
    {
      "id": "DestChangeRequested",
      "kind": "intermediate",
      "user_label": "Change requested",
      "lozenge": "attention",
      "description": "Request recorded with requester identity and channel. The previous verified version stays effective for every payment."
    },
    {
      "id": "DestEvidenceCollecting",
      "kind": "intermediate",
      "user_label": "Verifying account",
      "lozenge": "neutral",
      "description": "Collecting evidence named in the Treasury DestinationEvidence table (bank-originated account-owner match, prenote/return absence)."
    },
    {
      "id": "DestCallbackPending",
      "kind": "intermediate",
      "user_label": "Awaiting callback",
      "lozenge": "attention",
      "description": "Independent callback using a contact sourced separately from the change request (registry contact, not the request's contact)."
    },
    {
      "id": "DestFraudSuspected",
      "kind": "intermediate",
      "user_label": "Under security review",
      "lozenge": "blocked",
      "description": "Owner mismatch, related-party owner match, callback denial or other fraud signal. No activation possible."
    },
    {
      "id": "DestPending",
      "kind": "intermediate",
      "user_label": "Verified – pending activation",
      "lozenge": "neutral",
      "description": "Evidence meets the rail minimum; waiting for the effective time/cooling-off period and old-channel notice."
    },
    {
      "id": "DestActive",
      "kind": "intermediate",
      "user_label": "Active",
      "lozenge": "ok",
      "description": "Effective destination version. Payments authorized after activation pin this version; payments authorized earlier stay on the version pinned at authorization."
    },
    {
      "id": "DestSuperseded",
      "kind": "terminal",
      "user_label": "Replaced",
      "lozenge": "neutral",
      "description": "A newer version became Active."
    },
    {
      "id": "DestRevoked",
      "kind": "terminal",
      "user_label": "Revoked",
      "lozenge": "blocked",
      "description": "Account closed (R02/R03/R04), fraud discovered or charity withdrew the account."
    },
    {
      "id": "DestRejected",
      "kind": "terminal",
      "user_label": "Rejected",
      "lozenge": "blocked",
      "description": "Verification failed or fraud confirmed; charity notified on its verified channel."
    },
    {
      "id": "DestWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Requester withdrew before activation."
    },
    {
      "id": "DestExpired",
      "kind": "terminal",
      "user_label": "Expired",
      "lozenge": "neutral",
      "description": "Callback or evidence window elapsed without verification."
    }
  ],
  "transitions": [
    {
      "id": "WFM-13-T01",
      "from": "DestDraft",
      "to": "DestChangeRequested",
      "trigger": "command",
