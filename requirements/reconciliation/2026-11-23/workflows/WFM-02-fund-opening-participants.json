  ],
  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-006"
  ],
  "states": [
    {
      "id": "FundApplicationDraft",
      "kind": "initial",
      "user_label": "Application draft",
      "lozenge": "attention",
      "description": "Applicant is completing progressive intake (intent, fund name, participants, successor intent)."
    },
    {
      "id": "FundApplicationSubmitted",
      "kind": "intermediate",
      "user_label": "Application submitted",
      "lozenge": "attention",
      "description": "Agreement version accepted with the exclusive-legal-control acknowledgment; regime register evaluated for the applicant's role and channel."
    },
    {
      "id": "FundApplicantIdentityProofing",
      "kind": "intermediate",
      "user_label": "Verifying identity",
      "lozenge": "attention",
      "description": "Identity proofing at the sponsor-configured assurance level (advisory-privilege holder) and sanctions screening are running."
    },
    {
      "id": "FundApplicantCheckUnknown",
      "kind": "intermediate",
      "user_label": "Check result unknown",
      "lozenge": "unknown",
      "description": "Identity or sanctions provider returned no definite result; the application waits and is not activated (RR-UNB-PART-007-r1 AC-2)."
    },
    {
      "id": "FundApplicantPotentialMatch",
      "kind": "intermediate",
      "user_label": "Under compliance review",
      "lozenge": "blocked",
      "description": "Potential sanctions match or identity conflict held for human disposition."
    },
    {
      "id": "FundApplicationInSponsorReview",
      "kind": "intermediate",
      "user_label": "In sponsor review",
      "lozenge": "attention",
      "description": "Checks passed; sponsor acceptance pending (ADM-003 separates drafted account and sponsor acceptance)."
    },
    {
      "id": "FundOpen",
      "kind": "intermediate",
      "user_label": "Open",
      "lozenge": "ok",
      "description": "Sponsor accepted; fund exists with the applicant as advisory-privilege holder. Further participants may be invited."
    },
    {
      "id": "FundApplicationRejected",
      "kind": "terminal",
      "user_label": "Not accepted",
      "lozenge": "blocked",
      "description": "Sponsor declined the application or identity proofing failed."
    },
    {
      "id": "FundApplicationWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Applicant withdrew or the draft expired."
    },
    {
      "id": "FundApplicantBlocked",
      "kind": "terminal",
      "user_label": "Blocked",
      "lozenge": "blocked",
      "description": "Confirmed sanctions true match; any property received is blocked and OFAC reporting started (UNB-RCN-REG-003)."
    },
    {
      "id": "FundRejectionFundsCase",
      "kind": "correction",
      "user_label": "Unaccepted funds return",
      "lozenge": "neutral",
      "description": "Linked child when money arrived for an application that was then rejected: property never accepted is returned only under the counsel-approved exception cited on the command (UNB-RCN-FIN-013)."
    },
    {
      "id": "ParticipantInvited",
      "kind": "intermediate",
      "user_label": "Invited",
      "lozenge": "attention",
      "description": "Invitation issued for a role from the single role catalogue (scope, effective dates, expiry)."
    },
    {
      "id": "ParticipantIdentityProofing",
      "kind": "intermediate",
      "user_label": "Verifying participant",
      "lozenge": "attention",
      "description": "Invitee accepted; checks the regime register requires for the role (identity proofing for advisory-privilege holders, successors and legal representatives; sanctions for all)."
    },
    {
      "id": "ParticipantCheckUnknown",
      "kind": "intermediate",
      "user_label": "Participant check unknown",
      "lozenge": "unknown",
      "description": "Provider returned no definite result; the role stays pending."
    },
    {
      "id": "ParticipantPotentialMatch",
      "kind": "intermediate",
      "user_label": "Participant under review",
      "lozenge": "blocked",
      "description": "Potential sanctions match or identity conflict held for human disposition."
    },
    {
      "id": "ParticipantRoleActive",
      "kind": "terminal",
      "user_label": "Role active",
      "lozenge": "ok",
      "description": "Participant holds the role within its scope; history appended."
    },
    {
      "id": "ParticipantInvitationDeclined",
      "kind": "terminal",
      "user_label": "Declined",
      "lozenge": "neutral",
      "description": "Invitee declined; recorded, no access granted."
    },
    {
      "id": "ParticipantInvitationExpired",
      "kind": "terminal",
      "user_label": "Invitation expired",
      "lozenge": "neutral",
      "description": "Invitation not accepted within its validity; token invalid."
    },
    {
      "id": "ParticipantInvitationRevoked",
      "kind": "terminal",
      "user_label": "Invitation withdrawn",
      "lozenge": "neutral",
      "description": "Inviter or sponsor withdrew the invitation, or the inviter lost authority, before acceptance."
    },
    {
      "id": "ParticipantNotVerified",
      "kind": "terminal",
      "user_label": "Not verified",
      "lozenge": "blocked",
      "description": "Identity proofing failed or a sanctions match was confirmed; no role granted."
    },
    {
      "id": "ParticipantRoleCorrection",
      "kind": "correction",
      "user_label": "Role corrected",
      "lozenge": "neutral",
      "description": "Linked correction when a role is later found to rest on invalid evidence (e.g. forged signature, TVS-313); actions taken under it are flagged for review, not auto-reversed."
    }
  ],
