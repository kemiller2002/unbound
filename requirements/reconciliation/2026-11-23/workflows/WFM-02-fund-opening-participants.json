{
  "workflow_id": "WFM-02",
  "name": "Fund application, sponsor acceptance and participant onboarding",
  "release": "R1",
  "outcome": "A fund opens only after the applicant accepts the agreement (with the exclusive-legal-control acknowledgment), passes the identity and sanctions checks that the regime register makes applicable, and the sponsor accepts; additional participants gain a role only after invitation acceptance and their own applicable checks",
  "aggregate": "Fund; ParticipantRelationship",
  "sources": [
    "RR-UNB-PART-007-r1",
    "UNB-RCN-ENT-010",
    "UNB-RCN-ENT-014",
