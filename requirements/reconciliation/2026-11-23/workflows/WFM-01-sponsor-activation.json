  "states": [
    {
      "id": "SponsorProspect",
      "kind": "initial",
      "user_label": "Prospect",
      "lozenge": "neutral",
      "description": "A prospective legal sponsor (501(c)(3) sponsoring organization) is in discussion; no tenant and no authority exist."
    },
    {
      "id": "SponsorDiligence",
      "kind": "intermediate",
      "user_label": "In diligence",
      "lozenge": "attention",
      "description": "Legal, financial and exemption-status diligence of the sponsor and negotiation of the sponsor contract and responsibility matrix (REQ-X-064)."
    },
    {
      "id": "SponsorContractExecuted",
      "kind": "intermediate",
      "user_label": "Contract signed",
      "lozenge": "attention",
      "description": "Sponsor contract and responsibility matrix executed by both parties; effective and expiry dates recorded."
    },
    {
      "id": "SponsorBoardDelegationRecorded",
      "kind": "intermediate",
      "user_label": "Board delegation recorded",
      "lozenge": "attention",
      "description": "Board resolution delegating approval authorities (grant approval, gift acceptance, policy approval, charitable default) recorded with effective dates; whether routine grant approval is delegated to deterministic policy (RCD-005) is an explicit flag, default not delegated."
    },
    {
      "id": "SponsorTenantProvisioning",
      "kind": "intermediate",
      "user_label": "Setting up workspace",
      "lozenge": "attention",
      "description": "Dedicated database for the legal sponsor is being provisioned on shared managed PostgreSQL from the current release (RCD-004 Profile B)."
    },
    {
      "id": "SponsorTenantProvisionUnknown",
      "kind": "intermediate",
      "user_label": "Setup status unknown",
      "lozenge": "unknown",
      "description": "Provisioning call returned no definite outcome; resolved by query on the provisioning idempotency key, never by blind re-run."
    },
    {
      "id": "SponsorTenantProvisionFailed",
      "kind": "intermediate",
      "user_label": "Setup failed",
      "lozenge": "blocked",
      "description": "Provisioning or the isolation test suite failed; no binding generation exists for the tenant."
    },
    {
      "id": "SponsorTenantProvisioned",
      "kind": "intermediate",
      "user_label": "Workspace ready",
      "lozenge": "attention",
      "description": "Tenant database provisioned, isolation suite passed, VerifiedTenantContext binding generation created."
    },
    {
      "id": "SponsorConfigurationDraft",
      "kind": "intermediate",
      "user_label": "Configuration in progress",
      "lozenge": "attention",
      "description": "Brand kit, terminology catalog, communication templates and initial sponsor policy version are drafted."
    },
    {
      "id": "SponsorConfigurationBlocked",
      "kind": "intermediate",
      "user_label": "Configuration blocked",
      "lozenge": "blocked",
      "description": "Publication validation failed: protected-term violation, missing legal-sponsor disclosure or unapproved initial policy."
    },
    {
      "id": "SponsorConfigurationValidated",
      "kind": "intermediate",
      "user_label": "Configuration validated",
      "lozenge": "attention",
      "description": "Brand manifest compiled, terminology passes the protected-term registry, legal-sponsor disclosure injected, initial policy version approved (WFM-24)."
    },
    {
      "id": "SponsorIntegrationsFailed",
      "kind": "intermediate",
      "user_label": "Integration checks failed",
      "lozenge": "blocked",
      "description": "Custodian feed, payment rail or identity/sanctions provider checks failed or returned no definite result."
    },
    {
      "id": "SponsorIntegrationsValidated",
      "kind": "intermediate",
      "user_label": "Integrations validated",
      "lozenge": "attention",
      "description": "Custodian, partner payment rail, positive-pay, identity proofing and sanctions providers validated in the sponsor's tenant."
    },
    {
      "id": "SponsorOpeningBalanceBreak",
      "kind": "intermediate",
      "user_label": "Opening balance break",
      "lozenge": "blocked",
      "description": "Opening balances do not tie to custodian/bank statements or to the migration tie-out (WFM-26)."
    },
    {
      "id": "SponsorOpeningBalancesTiedOut",
      "kind": "intermediate",
      "user_label": "Opening balances tied out",
      "lozenge": "attention",
      "description": "Opening GL (zero for a new sponsor, imported for a migrating sponsor) ties to external statements."
    },
    {
      "id": "SponsorReadyForActivation",
      "kind": "intermediate",
      "user_label": "Ready to activate",
      "lozenge": "attention",
      "description": "Finance readiness certified; waiting for the sponsor's authorized officer to activate."
    },
    {
      "id": "SponsorActive",
      "kind": "intermediate",
      "user_label": "Active",
      "lozenge": "ok",
      "description": "Program active: funds may open, contributions be accepted and grants approved within recorded authority."
    },
    {
      "id": "SponsorSuspended",
      "kind": "intermediate",
      "user_label": "Suspended",
      "lozenge": "blocked",
      "description": "Contract lapsed or suspended: no new funds, contributions or approvals; in-flight payments follow their own workflows; donors keep read access."
    },
    {
      "id": "SponsorExitInProgress",
      "kind": "intermediate",
      "user_label": "Exit in progress",
      "lozenge": "attention",
      "description": "Sponsor offboarding: every fund closed or transferred (WFM-22), governed export and retention preserved."
    },
    {
      "id": "SponsorOffboarded",
      "kind": "terminal",
      "user_label": "Offboarded",
      "lozenge": "neutral",
      "description": "Program exited; retained records preserved for their retention classes; tenant read-only."
    },
    {
      "id": "SponsorActivationWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Prospect or onboarding abandoned before activation; any partial setup retained as evidence, no authority granted."
    },
    {
      "id": "SponsorExitCorrection",
      "kind": "correction",
      "user_label": "Exit correction",
      "lozenge": "neutral",
      "description": "Linked correction child for a late receipt, retention defect or export error found after offboarding; the offboarded record is unchanged."
    }
  ],
