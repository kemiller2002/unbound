{
  "workflow_id": "WFM-07",
  "name": "Grant recommendation (donor and advisor side)",
  "release": "R1",
  "outcome": "A donor or advisor's recommendation reaches the sponsor exactly once, bound to a canonical charity and a valid affirmation, or ends with a stated reason",
  "aggregate": "GrantRecommendation",
  "sources": [
    "UNB-RCN-GRT-010",
    "UNB-RCN-GRT-009",
    "UNB-RCN-GRT-012",
    "RR-UNB-GRANT-011-r1",
    "UNB-RCN-PLT-014",
    "UNB-UI-S-003",
    "RCD-016",
    "RCD-014",
    "RR-REQ-X-008-r1",
    "RR-UNB-SUCC-008-r1",
    "TX-10",
    "TX-26",
    "06-state-models/state-models.md §1 REC-1..REC-7"
  ],
  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-004",
    "UNB-UI-W-001"
  ],
  "states": [
    {
      "id": "RecDraft",
      "kind": "initial",
      "user_label": "Draft",
      "lozenge": "neutral",
      "description": "Recommendation being prepared in the S-003 wizard. No financial effect; may hold a soft pending claim that lowers only the displayed recommendable amount (REC-1)."
    },
    {
      "id": "RecAwaitingPrincipalConfirmation",
      "kind": "intermediate",
      "user_label": "Waiting for your confirmation",
      "lozenge": "attention",
      "description": "Prepared by a delegate (professional advisor or co-advisor) whose role grant requires the principal's confirmation."
    },
    {
      "id": "RecSubmitted",
      "kind": "intermediate",
      "user_label": "Submitted",
      "lozenge": "neutral",
      "description": "Accepted with valid AffirmationEvidence; a sponsor-side grant (WFM-08) is under review. The requester can still withdraw."
    },
    {
      "id": "RecReaffirmationRequired",
      "kind": "intermediate",
      "user_label": "Needs your confirmation",
      "lozenge": "attention",
      "description": "The disclosure version or sponsor policy version changed after submission; the affirmation is invalid until the requester re-affirms (UNB-RCN-GRT-010)."
    },
    {
      "id": "RecAuthorityHeld",
      "kind": "intermediate",
      "user_label": "On hold – authority review",
      "lozenge": "attention",
      "description": "The requester's authority changed before a decision (death or incapacity notice, revocation). Not decided under authority that no longer exists (REC-3)."
    },
    {
      "id": "RecDecided",
      "kind": "terminal",
      "user_label": "Decision issued",
      "lozenge": "neutral",
      "description": "The sponsor approved or declined (outcome on the grant, WFM-08). After this only a cancellation request is possible."
    },
    {
      "id": "RecPolicyRejected",
      "kind": "terminal",
      "user_label": "Not accepted",
      "lozenge": "blocked",
      "description": "Rejected by the deterministic intake policy (prohibited recipient class, benefit-bearing host context, pledge prohibited) with an explanation."
    },
    {
      "id": "RecWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Withdrawn by the requester before a sponsor decision; the linked grant closed in the same operation (REC-5)."
    },
    {
      "id": "RecSuperseded",
      "kind": "terminal",
      "user_label": "Replaced by an edit",
      "lozenge": "neutral",
      "description": "Material edit after submission created a new linked recommendation."
    },
    {
      "id": "RecLapsed",
      "kind": "terminal",
      "user_label": "Lapsed",
      "lozenge": "neutral",
      "description": "Sponsor lapsed the recommendation after an authority change."
    },
    {
      "id": "RecExpired",
      "kind": "terminal",
      "user_label": "Expired",
      "lozenge": "neutral",
      "description": "Draft, confirmation or re-affirmation window elapsed."
    }
  ],
  "transitions": [
    {
      "id": "WFM-07-T01",
      "from": "RecDraft",
      "to": "RecSubmitted",
      "trigger": "command",
      "name": "SubmitRecommendation",
      "actor_type": "human",
      "actor_role": "Donor or advisory-privilege holder",
      "authority": "A2",
      "guards": [
        "authority-current",
        "affirmation-valid-current-disclosure",
        "canonical-charity-bound",
        "pledge-policy-satisfied",
        "host-context-declared"
      ],
      "effects": [
        "record-affirmation-evidence",
        "soft-pending-claim",
        "create-grant-under-review",
        "notify"
      ],
      "idempotency_key": "(fundId, draftHash, clientIdempotencyKey)",
      "failure": [
        {
          "condition": "AffirmationMissingOrStaleVersion",
          "to_state": "RecDraft"
        },
        {
          "condition": "RecipientNotCanonical",
          "to_state": "RecDraft"
        },
        {
          "condition": "RoleGrantOutOfScope",
          "to_state": "RecDraft"
        }
      ],
      "requirement_ids": [
