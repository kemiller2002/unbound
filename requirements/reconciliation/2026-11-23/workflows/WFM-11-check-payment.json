{
  "workflow_id": "WFM-11",
  "name": "Check grant payment with positive pay",
  "release": "R1",
  "outcome": "Each check is issued once under positive pay, and every uncashed, stale, lost, voided or escheatable check ends in a recorded disposition",
  "aggregate": "PaymentAttempt (check rail)",
  "sources": [
    "UNB-RCN-GRT-005",
    "RCD-028",
    "RR-REQ-X-083-r1",
    "RR-UNB-PAY-006-r1",
    "UNB-RCN-GRT-015",
    "UNB-RCN-GRT-007",
    "UNB-RCN-ENT-005",
    "CTL-044",
    "TX-13",
    "TX-16",
    "06-state-models/state-models.md §3 PA-4",
    "RCF-GRT-012",
    "RCF-GRT-020"
  ],
  "observer_surfaces": [
    "UNB-UI-S-004",
    "UNB-UI-S-008",
    "UNB-UI-S-012"
  ],
  "states": [
    {
      "id": "CheckPaymentPrepared",
      "kind": "initial",
      "user_label": "Preparing check",
      "lozenge": "neutral",
      "description": "Check instruction created from a Funded grant with verified mailing destination pinned."
    },
    {
      "id": "CheckReleaseBlocked",
      "kind": "intermediate",
      "user_label": "Release blocked",
      "lozenge": "blocked",
      "description": "A release gate failed (hold watermark, eligibility, sanctions, destination). Not printed."
    },
    {
      "id": "CheckIssued",
      "kind": "intermediate",
      "user_label": "Check issued",
      "lozenge": "neutral",
      "description": "Printed; positive-pay issue file submitted. Reservation consumed into an outstanding-check liability (PA-4)."
    },
    {
      "id": "CheckIssueUnknown",
      "kind": "intermediate",
      "user_label": "Issue status unknown",
      "lozenge": "unknown",
      "description": "Positive-pay issue file acknowledgement missing or ambiguous."
    },
    {
      "id": "CheckOutstanding",
      "kind": "intermediate",
      "user_label": "Mailed – not yet cashed",
      "lozenge": "neutral",
      "description": "Positive pay acknowledged; check mailed and unpresented."
    },
    {
      "id": "CheckAgedOutreach",
      "kind": "intermediate",
      "user_label": "Not yet cashed – contacting charity",
      "lozenge": "attention",
      "description": "Configured day threshold passed (Controller-owned); outreach to the charity on verified channels."
    },
    {
      "id": "CheckStaleDated",
      "kind": "intermediate",
      "user_label": "Stale-dated",
      "lozenge": "attention",
      "description": "Stale threshold reached (default 180 days, RCD-028); void is due."
    },
    {
      "id": "CheckVoidRequested",
      "kind": "intermediate",
      "user_label": "Void requested",
      "lozenge": "unknown",
      "description": "Positive-pay void file submitted; bank confirmation pending."
    },
    {
      "id": "CheckVoidConfirmed",
      "kind": "intermediate",
      "user_label": "Voided",
      "lozenge": "neutral",
      "description": "Bank acknowledged the positive-pay void. Disposition (re-credit, reissue or unclaimed-property) pending."
    },
    {
      "id": "CheckEscheatReview",
      "kind": "intermediate",
      "user_label": "Unclaimed property review",
      "lozenge": "attention",
      "description": "Jurisdiction dormancy rule applies or counsel position is pending; funds may not be silently returned to the fund."
    },
    {
      "id": "CheckUnclaimedPropertyReportable",
      "kind": "intermediate",
      "user_label": "Reportable as unclaimed property",
      "lozenge": "attention",
      "description": "Counsel-approved rule says the check is reportable; report and remittance due."
    },
    {
      "id": "CheckBlocked",
      "kind": "intermediate",
      "user_label": "Blocked",
      "lozenge": "blocked",
      "description": "List-update rescreen confirmed a true match on an outstanding check; stop placed; BlockedProperty."
    },
    {
      "id": "CheckCleared",
      "kind": "terminal",
      "user_label": "Cashed",
      "lozenge": "ok",
      "description": "Presented and paid under positive pay; outstanding liability cleared."
    },
    {
      "id": "CheckRecredited",
      "kind": "terminal",
      "user_label": "Voided – returned to fund",
      "lozenge": "neutral",
      "description": "Re-credited to the originating fund by a linked compensating entry after a recorded disposition; charity and donor notified."
    },
    {
      "id": "CheckReissued",
      "kind": "terminal",
      "user_label": "Replaced",
      "lozenge": "neutral",
      "description": "Linked replacement chain created (check or ACH) after VoidConfirmed and fresh eligibility and destination checks."
    },
    {
      "id": "CheckEscheated",
      "kind": "terminal",
      "user_label": "Sent to state as unclaimed property",
      "lozenge": "neutral",
      "description": "Unclaimed-property report and remittance evidence recorded."
    },
    {
      "id": "CheckAbandoned",
      "kind": "terminal",
      "user_label": "Canceled before issue",
      "lozenge": "neutral",
      "description": "Grant canceled before printing."
    },
    {
      "id": "CheckPaymentCorrection",
      "kind": "correction",
      "user_label": "Under correction",
      "lozenge": "attention",
      "description": "Linked correction child: a voided, replaced or escheated check was paid anyway, or a cleared item was returned (forged endorsement)."
    }
  ],
