{
  "workflow_id": "WFM-14",
  "name": "Pool valuation and unit pricing",
  "release": "R1",
  "outcome": "Each pool's NAV is struck from validated inputs, independently approved, published once, monitored for liquidity and corrected only by linked restatement",
  "aggregate": "PoolValuationRun",
  "sources": [
    "UNB-NAV-005",
    "UNB-NAV-038",
    "UNB-RCN-FIN-007",
    "RCD-017",
    "RR-UNB-ACC-018-r1"
  ],
  "observer_surfaces": [
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "NavRunScheduled",
      "kind": "initial",
      "user_label": "Scheduled",
      "lozenge": "neutral",
      "description": "Valuation run for one pool and valuation date, created from the approved calendar."
    },
    {
      "id": "NavInputsPending",
      "kind": "intermediate",
      "user_label": "Awaiting inputs",
      "lozenge": "attention",
      "description": "Waiting for custodian positions and cash, prices, accruals and the cutoff."
    },
    {
      "id": "NavInputException",
      "kind": "intermediate",
      "user_label": "Input exception",
      "lozenge": "unknown",
      "description": "Feed missing at cutoff, or price stale, missing, conflicting or outlier; never forward-filled."
    },
    {
      "id": "NavInputsValidated",
      "kind": "intermediate",
      "user_label": "Inputs validated",
      "lozenge": "attention",
      "description": "Positions, cash, identifiers, corporate actions and accruals validated against high-water marks."
    },
    {
      "id": "NavCalculated",
      "kind": "intermediate",
      "user_label": "Calculated",
      "lozenge": "attention",
      "description": "Deterministic NAV and unit price computed in fixed-precision decimal."
    },
    {
      "id": "NavExceptionHold",
      "kind": "intermediate",
      "user_label": "Exception hold",
      "lozenge": "blocked",
      "description": "Tolerance breach or material reconciliation break for the pool; publication blocked."
    },
    {
      "id": "NavReadyForApproval",
      "kind": "intermediate",
      "user_label": "Awaiting approval",
      "lozenge": "attention",
      "description": "Within tolerance; awaiting independent checker."
    },
    {
      "id": "NavApproved",
      "kind": "intermediate",
      "user_label": "Approved",
      "lozenge": "ok",
      "description": "Independently approved; not yet published."
    },
    {
      "id": "NavPublished",
      "kind": "intermediate",
      "user_label": "Published",
      "lozenge": "ok",
      "description": "Published NAV; unit transactions strike at this price (forward pricing)."
    },
    {
      "id": "NavLiquidityBufferLow",
      "kind": "intermediate",
      "user_label": "Liquidity buffer below floor",
      "lozenge": "attention",
      "description": "Pool cash below the sponsor-set buffer; replenishment decision pending."
    },
    {
      "id": "NavCycleComplete",
      "kind": "terminal",
      "user_label": "Cycle complete",
      "lozenge": "ok",
      "description": "Published and liquidity checked."
    },
    {
      "id": "NavRunSkipped",
      "kind": "terminal",
      "user_label": "No valuation (calendar)",
      "lozenge": "neutral",
      "description": "Market holiday or non-valuation day."
    },
    {
      "id": "NavRunSuspended",
      "kind": "terminal",
      "user_label": "Valuation suspended",
      "lozenge": "blocked",
      "description": "Valuation suspended (market halt, custodian outage); unit transactions gated."
    },
    {
      "id": "NavCorrectionOpened",
      "kind": "correction",
      "user_label": "Correction opened",
      "lozenge": "attention",
      "description": "Linked correction child of a published NAV, after a back-dated source correction."
    },
    {
      "id": "NavCorrectionAssessed",
      "kind": "correction",
      "user_label": "Impact assessed",
      "lozenge": "attention",
      "description": "Counterfactual NAV, units and money impacts per fund, transaction, grant, fee and statement computed."
    },
    {
      "id": "NavCorrectionBelowMateriality",
      "kind": "correction",
      "user_label": "Correction below materiality",
      "lozenge": "neutral",
      "description": "Below the sponsor materiality policy: no restatement; forward adjustment with evidence."
    },
    {
      "id": "NavRestated",
      "kind": "correction",
      "user_label": "Restated",
      "lozenge": "ok",
      "description": "New approved publication linked to the original; remediation executed; original preserved."
    }
  ],
  "transitions": [
