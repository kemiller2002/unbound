    {
      "id": "SupportCaseOpened",
      "kind": "initial",
      "user_label": "Received",
      "lozenge": "attention",
      "description": "Request received from a donor, advisor, charity or partner via any channel, with channel and assurance level recorded."
    },
    {
      "id": "SupportCaseTriaged",
      "kind": "intermediate",
      "user_label": "In progress",
      "lozenge": "attention",
      "description": "Classified (question, document request, assisted change, complaint, reconsideration) and routed."
    },
    {
      "id": "SupportAssistedChangePending",
      "kind": "intermediate",
      "user_label": "Awaiting your confirmation",
      "lozenge": "attention",
      "description": "Staff prepared a change (contact, payee, preference, recommendation edit); confirmation sent to the verified channel."
    },
    {
      "id": "SupportSuspectedFraud",
      "kind": "intermediate",
      "user_label": "Security review",
      "lozenge": "blocked",
      "description": "Donor denied the assisted change on the verified channel; protective hold and security case opened."
    },
    {
      "id": "SupportReconsideration",
      "kind": "intermediate",
      "user_label": "Under reconsideration",
      "lozenge": "attention",
      "description": "Independent sponsor reviewer re-examines a sponsor decision (grant decline, hold, fund decision, fee)."
    },
    {
      "id": "SupportAwaitingRequester",
      "kind": "intermediate",
      "user_label": "Waiting on you",
      "lozenge": "attention",
      "description": "More information requested from the requester."
    },
    {
      "id": "SupportReconsiderationDecided",
      "kind": "intermediate",
      "user_label": "Decision made",
      "lozenge": "attention",
      "description": "Outcome recorded (Upheld, Overturned, Modified, Referred); any new decision issued to the subject workflow."
    },
    {
      "id": "SupportCaseResolved",
      "kind": "intermediate",
      "user_label": "Resolved",
      "lozenge": "ok",
      "description": "Answer, change or outcome delivered; reopen window running."
    },
    {
      "id": "SupportCaseClosed",
      "kind": "terminal",
      "user_label": "Closed",
      "lozenge": "ok",
      "description": "Reopen window elapsed or requester confirmed; closure proof recorded."
    },
    {
      "id": "SupportCaseWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Requester withdrew the request."
    },
    {
      "id": "SupportCaseCorrection",
      "kind": "correction",
      "user_label": "Case corrected",
      "lozenge": "neutral",
      "description": "Linked correction when a closed case is found to have been closed on a wrong basis."
