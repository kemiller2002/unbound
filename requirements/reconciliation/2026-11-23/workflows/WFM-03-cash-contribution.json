  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-007",
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "CashContributionNew",
      "kind": "initial",
      "user_label": "New",
      "lozenge": "neutral",
      "description": "No contribution record yet. Created either by a donor declaration or by an unannounced bank receipt."
    },
    {
      "id": "CashContributionDeclared",
      "kind": "intermediate",
      "user_label": "Declared",
      "lozenge": "attention",
      "description": "Intent recorded (rail ACH/wire/check, amount, fund, contributor of record). No ledger entry and no capacity (INV-01)."
    },
    {
      "id": "CashAchDebitSubmitted",
      "kind": "intermediate",
      "user_label": "Debit submitted",
      "lozenge": "attention",
      "description": "ACH debit submitted to the partner rail with an idempotency key; not received."
    },
    {
      "id": "CashAchDebitUnknown",
      "kind": "intermediate",
      "user_label": "Debit outcome unknown",
      "lozenge": "unknown",
      "description": "Partner rail gave no definite outcome for the debit; no re-submission until resolved."
    },
    {
      "id": "CashReceivedUnmatched",
      "kind": "intermediate",
      "user_label": "Unidentified receipt",
      "lozenge": "attention",
      "description": "Funds observed on the bank feed that cannot be matched to a declaration or fund; held in suspense, never credited."
    },
    {
      "id": "CashReceived",
      "kind": "intermediate",
      "user_label": "Received",
      "lozenge": "attention",
      "description": "Receipt evidence recorded by rail (bank trace, lockbox deposit). Clearing entry posted; not accepted, not final, not grantable."
    },
    {
      "id": "CashContributionHeld",
      "kind": "intermediate",
      "user_label": "Held for review",
      "lozenge": "blocked",
      "description": "Completed-gift evidence missing, potential sanctions match, source-of-funds review above threshold, or fund not active."
    },
    {
      "id": "CashAccepted",
      "kind": "intermediate",
      "user_label": "Accepted, not final",
      "lozenge": "attention",
      "description": "CompletedGiftDetermined and SponsorAccepted recorded; rail can still reverse (ACH return window, check not cleared). Not grantable."
    },
    {
      "id": "CashAcknowledgedNotFinal",
      "kind": "intermediate",
      "user_label": "Acknowledged, not final",
      "lozenge": "attention",
      "description": "Acknowledgment issued under a sponsor policy that permits pre-final acknowledgment; rail can still reverse."
    },
    {
      "id": "CashFinalNotAcknowledged",
      "kind": "intermediate",
      "user_label": "Final, acknowledgment pending",
      "lozenge": "attention",
      "description": "Final: grantable capacity credited. Acknowledgment not yet issued."
    },
    {
      "id": "CashContributionComplete",
      "kind": "terminal",
      "user_label": "Final and acknowledged",
      "lozenge": "ok",
      "description": "Final, credited to grantable capacity, acknowledgment issued."
    },
    {
      "id": "CashContributionReturned",
      "kind": "terminal",
      "user_label": "Returned",
      "lozenge": "blocked",
      "description": "Rail returned the funds before Final; clearing entry reversed; no capacity was ever credited; any acknowledgment voided via WFM-18."
    },
    {
      "id": "CashContributionBlocked",
      "kind": "terminal",
      "user_label": "Blocked (sanctions)",
      "lozenge": "blocked",
      "description": "Confirmed sanctions true match: property blocked, OFAC report started; no movement."
    },
    {
      "id": "CashCollectionFailed",
      "kind": "terminal",
      "user_label": "Collection failed",
      "lozenge": "blocked",
      "description": "ACH debit rejected by the rail before settlement (e.g. invalid account)."
    },
    {
      "id": "CashReturnToSenderPending",
      "kind": "intermediate",
      "user_label": "Return to sender approved",
      "lozenge": "attention",
      "description": "Unaccepted funds approved for return to the remitter (pre-acceptance exception, UNB-RCN-FIN-013)."
    },
    {
      "id": "CashReturnToSenderUnknown",
      "kind": "intermediate",
      "user_label": "Return outcome unknown",
      "lozenge": "unknown",
      "description": "Outbound return dispatched but outcome not determinable; no re-dispatch."
    },
    {
      "id": "CashReturnedToSender",
      "kind": "terminal",
      "user_label": "Returned to sender",
      "lozenge": "neutral",
      "description": "Unaccepted funds returned to the remitter with settlement evidence."
    },
    {
      "id": "CashReceiptDuplicateMerged",
      "kind": "terminal",
      "user_label": "Merged duplicate",
      "lozenge": "neutral",
      "description": "Receipt shown to be the same money as another record (e.g. bank feed and custodian sweep); no second credit."
    },
    {
      "id": "CashContributionCancelled",
      "kind": "terminal",
      "user_label": "Cancelled",
      "lozenge": "neutral",
      "description": "Donor cancelled the declaration before any receipt."
    },
    {
      "id": "CashContributionLapsed",
      "kind": "terminal",
      "user_label": "Lapsed",
      "lozenge": "neutral",
      "description": "No receipt within the sponsor-set declaration window."
    },
    {
      "id": "CashReturnExposure",
      "kind": "correction",
      "user_label": "Returned after final",
      "lozenge": "blocked",
      "description": "Linked correction child: rail return after Final. ReturnedContributionExposure recorded, capacity reduced immediately, downstream grants preserved, acknowledgment corrected."
    },
    {
      "id": "CashContributionReattributed",
      "kind": "correction",
      "user_label": "Corrected (fund reattributed)",
      "lozenge": "neutral",
      "description": "Linked correction child moving a misapplied contribution to the intended fund with balanced, approved entries."
    }
  ],
