{
  "workflow_id": "WFM-03",
  "name": "Cash contribution (ACH, wire, check)",
  "release": "R1",
  "outcome": "Each cash gift is received once, accepted, made final, credited to grantable capacity exactly once and acknowledged with a compliant acknowledgment",
  "aggregate": "Contribution",
  "sources": [
    "RR-UNB-ACC-006-r1",
    "UNB-RCN-FIN-001",
    "UNB-RCN-FIN-012",
    "UNB-RCN-FIN-013",
    "RCD-019",
    "RCD-013",
    "RR-REQ-X-009-r1",
    "TX-01",
    "TX-02",
    "TX-03",
    "TX-04",
    "TX-05"
