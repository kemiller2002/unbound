{
  "workflow_id": "WFM-17",
  "name": "Annual DAF reporting (Schedule D Part I support)",
  "release": "R1",
  "outcome": "Each legal sponsor receives a reproducible, ledger-reconciled DAF annual package, prepared, reviewed and signed by distinct people, with filing and acceptance evidenced",
  "aggregate": "AnnualDafReport",
  "sources": [
    "RR-REQ-X-060-r1",
    "UNB-RCN-ENT-011",
    "UNB-RCN-ENT-012",
    "UNB-UI-D-004",
    "RCD-024",
    "TX-22"
  ],
  "observer_surfaces": [
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "AnnualReportNotStarted",
      "kind": "initial",
      "user_label": "Not started",
      "lozenge": "neutral",
      "description": "Tax year not yet ended for this legal sponsor."
    },
    {
      "id": "AnnualReportRegisterCheck",
      "kind": "intermediate",
      "user_label": "Checking classification register",
      "lozenge": "attention",
      "description": "Verifying a counsel-approved account-type classification register version covers every product used in the year."
    },
    {
      "id": "AnnualReportRegisterBlocked",
      "kind": "intermediate",
      "user_label": "Blocked: classification register",
      "lozenge": "blocked",
      "description": "Register missing, unapproved or incomplete for a product type used in the year."
    },
    {
      "id": "AnnualReportAwaitingLock",
      "kind": "intermediate",
      "user_label": "Awaiting locked year",
      "lozenge": "attention",
      "description": "Waiting until every period in the tax year is certified and locked."
    },
    {
      "id": "AnnualReportPackageBuilt",
      "kind": "intermediate",
      "user_label": "Package built",
      "lozenge": "attention",
      "description": "Package built from the locked ledger with as-of and known-at; synthetic and canary items excluded."
    },
    {
      "id": "AnnualReportBreak",
      "kind": "intermediate",
      "user_label": "Does not reconcile",
      "lozenge": "blocked",
      "description": "Package totals do not reconcile to the ledger."
    },
    {
      "id": "AnnualReportReconciled",
      "kind": "intermediate",
      "user_label": "Reconciled to ledger",
      "lozenge": "attention",
      "description": "Every aggregate reconciles to the ledger."
    },
    {
      "id": "AnnualReportPrepared",
      "kind": "intermediate",
      "user_label": "Prepared",
      "lozenge": "attention",
      "description": "Preparer has mapped the package to form lines with the CPA data dictionary."
    },
    {
      "id": "AnnualReportReviewed",
      "kind": "intermediate",
      "user_label": "Reviewed",
      "lozenge": "attention",
      "description": "Reviewed by a person other than the preparer."
    },
    {
      "id": "AnnualReportSigned",
      "kind": "intermediate",
      "user_label": "Signed",
      "lozenge": "attention",
      "description": "Signed by an authorized officer who is not the preparer."
    },
    {
      "id": "AnnualReportFiled",
      "kind": "intermediate",
      "user_label": "Filed, awaiting acceptance",
      "lozenge": "attention",
      "description": "Submission evidence recorded; filed by the sponsor's filer (Unbound has no filing authority)."
    },
    {
      "id": "AnnualReportRejected",
      "kind": "intermediate",
      "user_label": "Rejected by IRS",
      "lozenge": "blocked",
      "description": "Filing rejected; correction required."
    },
    {
      "id": "AnnualReportAccepted",
      "kind": "terminal",
      "user_label": "Accepted",
      "lozenge": "ok",
      "description": "Acceptance evidence recorded."
    },
    {
      "id": "AnnualReportNotApplicable",
      "kind": "terminal",
      "user_label": "Not applicable",
      "lozenge": "neutral",
      "description": "Counsel recorded that no DAF reporting obligation applies for this sponsor and year."
    },
    {
      "id": "AnnualReportAmending",
      "kind": "correction",
      "user_label": "Amendment in progress",
      "lozenge": "attention",
      "description": "Linked correction after acceptance (restatement or error found)."
    },
    {
      "id": "AnnualReportAmended",
      "kind": "correction",
      "user_label": "Amended return filed",
      "lozenge": "ok",
      "description": "Amended return filed and accepted; original package preserved."
    }
  ],
