{
  "workflow_id": "WFM-12",
  "name": "Sanctions screening, disposition and blocking",
  "release": "R1",
  "outcome": "Every in-scope subject is screened at each trigger; potential matches hold dependent releases until a human dispositions them; confirmed matches block property and are reported to OFAC on time",
  "aggregate": "ScreeningSubject (one per party or recipient subject in the ScreeningScope matrix)",
  "sources": [
    "UNB-RCN-GRT-007",
    "UNB-RCN-GRT-006",
    "UNB-RCN-REG-003",
    "RR-UNB-EXT-004-r1",
    "RCD-015",
    "RCD-007",
    "RR-REQ-X-036-r1",
    "RR-REQ-X-020-r1",
    "RCF-GRT-013",
    "RCF-GRT-014",
    "RCF-REG-006"
  ],
  "observer_surfaces": [
    "UNB-UI-S-008",
    "UNB-UI-S-011",
    "UNB-UI-S-004"
  ],
  "states": [
    {
      "id": "ScreeningRequested",
      "kind": "initial",
      "user_label": "Screening",
      "lozenge": "neutral",
      "description": "Screen requested at a ScreeningScope trigger: onboarding, grant approval, payment release or a list update. Subjects: donors, advisors, successors, recipient entity, payee account holder, recipient officers where data exists."
    },
    {
      "id": "ScreeningProviderUnknown",
      "kind": "intermediate",
      "user_label": "Screening status unknown",
      "lozenge": "unknown",
      "description": "Screening provider timed out or was unavailable. Dependent approvals and releases fail closed."
    },
    {
      "id": "ScreeningClear",
      "kind": "intermediate",
      "user_label": "Clear",
      "lozenge": "ok",
      "description": "No match on the current list versions; good-guy suppressions recorded with evidence."
    },
    {
      "id": "ScreeningPotentialMatch",
      "kind": "intermediate",
      "user_label": "Potential match – on hold",
      "lozenge": "attention",
      "description": "Match rule fired. Name similarity alone is not adverse. Dependent releases are held via the hold registry."
    },
    {
      "id": "ScreeningEscalated",
      "kind": "intermediate",
      "user_label": "Escalated to compliance officer",
      "lozenge": "attention",
      "description": "Analyst could not dispose; escalated to the sanctions compliance officer."
    },
    {
      "id": "ScreeningOfacReportDue",
      "kind": "intermediate",
      "user_label": "Blocked – OFAC report due",
      "lozenge": "blocked",
      "description": "Confirmed true match involving property in the sponsor's possession; property blocked; blocked-property report due within 10 business days."
    },
    {
      "id": "ScreeningOfacReported",
      "kind": "intermediate",
      "user_label": "Blocked – reported",
      "lozenge": "blocked",
      "description": "Initial report filed; annual report tracked; property stays blocked until licence or delisting."
    },
    {
      "id": "ScreeningRejectedNoProperty",
      "kind": "terminal",
      "user_label": "Confirmed match – refused",
      "lozenge": "blocked",
      "description": "Confirmed true match with no property in the sponsor's possession (e.g. onboarding refused). Records retained 10 years."
    },
    {
      "id": "ScreeningSubjectClosed",
      "kind": "terminal",
      "user_label": "No longer screened",
      "lozenge": "neutral",
      "description": "Relationship ended with no open items; records retained per the OFAC retention class (10 years)."
    },
    {
      "id": "ScreeningCorrection",
      "kind": "correction",
      "user_label": "Determination corrected",
      "lozenge": "neutral",
      "description": "Linked correction child for a mistaken determination; original decision record unchanged."
    }
  ],
  "transitions": [
    {
      "id": "WFM-12-T01",
      "from": "ScreeningRequested",
      "to": "ScreeningClear",
      "trigger": "command",
      "name": "ScreenSubject",
      "actor_type": "deterministic",
      "actor_role": "Screening service (ScreeningScope matrix, versioned lists)",
      "authority": "A3",
      "guards": [
        "screening-scope-version-pinned",
        "list-version-current"
      ],
      "effects": [
        "external-call",
        "record-screening-result"
      ],
      "idempotency_key": "(subjectId, trigger, listVersion)",
      "failure": [
        {
          "condition": "TimeoutOrProviderUnavailable",
          "to_state": "ScreeningProviderUnknown"
        },
        {
          "condition": "PotentialMatch",
          "to_state": "ScreeningPotentialMatch"
        }
      ],
      "requirement_ids": [
        "UNB-RCN-GRT-007",
        "RR-UNB-EXT-004-r1",
        "RCD-015"
