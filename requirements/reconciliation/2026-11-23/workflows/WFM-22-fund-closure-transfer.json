{
  "workflow_id": "WFM-22",
  "name": "Fund closure, residual disposition and outbound transfer to another sponsor",
  "release": "R1",
  "outcome": "A fund closes only when no reservation is open, every payment attempt is terminal or moved to an outstanding-instrument liability, final fees are posted, the residual has left through the grant lifecycle (to charities or as a DAF_TRANSFER_OUT grant to an eligible sponsoring organization) and a destination for trailing receipts is recorded",
  "aggregate": "FundClosure",
  "sources": [
    "UNB-RCN-ENT-006",
    "UNB-RCN-ENT-007",
    "RR-UNB-WF-014-r1",
    "ADM-025",
    "OD-11",
    "RCD-022",
    "RCD-018",
    "RCD-028",
    "06-state-models/state-models.md#6 (FUND-1, FUND-3)"
  ],
  "observer_surfaces": [
    "UNB-UI-S-001",
    "UNB-UI-S-004",
    "UNB-UI-S-007"
  ],
  "states": [
    {
      "id": "ClosureRequested",
      "kind": "initial",
      "user_label": "Closure requested",
      "lozenge": "attention",
      "description": "Typed trigger recorded: donor request, zero balance, dormancy disposition, succession split, full outbound transfer or sponsor exit."
    },
    {
      "id": "ClosureObligationsResolving",
      "kind": "intermediate",
      "user_label": "Settling open items",
      "lozenge": "attention",
      "description": "New recommendations, recurring templates and standing contributions stopped; waiting for reservations, payment attempts, provisional contributions and open cases to finish."
    },
    {
      "id": "ClosureBlocked",
      "kind": "intermediate",
      "user_label": "Closure blocked",
      "lozenge": "blocked",
      "description": "An item cannot finish on its own: payment attempt Unknown, outstanding check, legal/sanctions hold, contested authority."
    },
    {
      "id": "ClosureObligationsResolved",
      "kind": "intermediate",
      "user_label": "Open items settled",
      "lozenge": "attention",
      "description": "All closure preconditions on in-flight items met."
    },
    {
      "id": "ClosureFinalFeesPosted",
      "kind": "intermediate",
      "user_label": "Final fees posted",
      "lozenge": "attention",
      "description": "Fees accrued through the fixed cut-off date and settled; residual equals authoritative capacity."
    },
    {
      "id": "ClosureResidualDispositionPending",
      "kind": "intermediate",
      "user_label": "Choose where the balance goes",
      "lozenge": "attention",
      "description": "Waiting for the advisory-privilege holder's residual recommendation (charities or another sponsor) or the program default."
    },
    {
      "id": "ClosureTransferOutReview",
      "kind": "intermediate",
      "user_label": "Checking receiving sponsor",
      "lozenge": "attention",
      "description": "Receiving organization's status as an eligible sponsoring organization is checked before the transfer grant is created."
    },
    {
      "id": "ClosureResidualGrantsInProgress",
      "kind": "intermediate",
      "user_label": "Residual grants in progress",
      "lozenge": "attention",
      "description": "Residual grants (including DAF_TRANSFER_OUT) are in the grant and payment workflows."
    },
    {
      "id": "ClosureResidualDisposed",
      "kind": "intermediate",
      "user_label": "Balance distributed",
      "lozenge": "attention",
      "description": "Every residual grant's payment is Final per rail; capacity is zero."
    },
    {
      "id": "ClosureClosed",
      "kind": "intermediate",
      "user_label": "Closed",
      "lozenge": "ok",
      "description": "Fund closed; trailing receipts route to the recorded destination."
    },
    {
      "id": "ClosureArchived",
      "kind": "terminal",
      "user_label": "Archived",
      "lozenge": "neutral",
      "description": "Trailing window ended; records retained under their retention classes."
    },
    {
      "id": "ClosureWithdrawn",
      "kind": "terminal",
      "user_label": "Closure cancelled",
      "lozenge": "neutral",
      "description": "Donor-requested closure withdrawn before the residual was committed; fund continues (ended templates stay ended)."
    },
    {
      "id": "ClosureLateEventCase",
      "kind": "correction",
      "user_label": "Late item after archive",
      "lozenge": "neutral",
      "description": "Linked child for a receipt, return, NAV restatement or tax allocation arriving after archive; the fund is not reopened."
    }
  ],
