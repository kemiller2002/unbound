{
  "workflow_id": "WFM-04",
  "name": "Publicly traded securities contribution (DTC)",
  "release": "R1",
  "outcome": "Each delivered lot is matched, accepted, valued, settled into custody and credited once, acknowledged by description, disposed per policy, with 8283/8282 obligations tracked",
  "aggregate": "Contribution",
  "sources": [
    "RR-UNB-ACC-006-r1",
    "RR-UNB-INV-012-r1",
    "UNB-RCN-FIN-002",
    "UNB-RCN-FIN-003",
    "UNB-RCN-FIN-011",
    "RCD-019",
    "TX-06",
    "TX-07",
    "TX-08",
    "TX-09"
  ],
  "observer_surfaces": [
    "UNB-UI-S-005",
    "UNB-UI-S-001",
    "UNB-UI-S-007"
  ],
  "states": [
    {
      "id": "SecuritiesGiftNew",
      "kind": "initial",
      "user_label": "New",
      "lozenge": "neutral",
      "description": "No record yet; created by a donor intent or by an unannounced DTC delivery."
    },
    {
      "id": "SecuritiesIntentDeclared",
      "kind": "intermediate",
      "user_label": "Transfer expected",
      "lozenge": "attention",
      "description": "Intent: security (CUSIP), quantity, delivering broker, fund. No ledger entry."
    },
    {
      "id": "SecuritiesDeliveryUnmatched",
      "kind": "intermediate",
      "user_label": "Unidentified delivery",
      "lozenge": "attention",
      "description": "Custodian reports a DTC receipt with no usable intent reference; held in suspense position."
    },
    {
      "id": "SecuritiesPartiallyReceived",
      "kind": "intermediate",
      "user_label": "Partially received",
      "lozenge": "attention",
      "description": "Some declared lots received at the custodian; acknowledgment withheld (DKS-REG-006)."
    },
    {
      "id": "SecuritiesReceived",
      "kind": "intermediate",
      "user_label": "Received",
      "lozenge": "attention",
      "description": "All expected lots (or the closed partial set) reported received by the custodian; not yet accepted."
    },
    {
      "id": "SecuritiesHeld",
      "kind": "intermediate",
      "user_label": "Held for review",
      "lozenge": "blocked",
      "description": "Restricted/legended security, unsupported asset, potential sanctions match, missing completed-gift evidence or fund not active."
    },
    {
      "id": "SecuritiesAccepted",
      "kind": "intermediate",
      "user_label": "Accepted",
      "lozenge": "attention",
      "description": "CompletedGiftDetermined and SponsorAccepted recorded per lot."
    },
    {
      "id": "SecuritiesValuationException",
      "kind": "intermediate",
      "user_label": "Valuation exception",
      "lozenge": "unknown",
      "description": "Gift-date price stale, missing or conflicting; no value recorded."
    },
    {
      "id": "SecuritiesValued",
      "kind": "intermediate",
      "user_label": "Valued",
      "lozenge": "attention",
      "description": "Separate typed values recorded: sponsor book value, custody receipt value (UTC timestamp, convention, price source)."
    },
    {
      "id": "SecuritiesFinal",
      "kind": "intermediate",
      "user_label": "Settled in custody",
      "lozenge": "ok",
      "description": "Position settled into sponsor custody and reconciled; grantable capacity credited at the policy value (haircut per RR-REQ-X-002-r1)."
    },
    {
      "id": "SecuritiesAcknowledged",
      "kind": "intermediate",
      "user_label": "Acknowledged",
      "lozenge": "ok",
      "description": "Acknowledgment issued describing the property (no value)."
    },
    {
      "id": "SecuritiesHeldInKind",
      "kind": "intermediate",
      "user_label": "Held in kind",
      "lozenge": "ok",
      "description": "Sponsor investment policy retains the position; later sale follows the same sale path."
    },
    {
      "id": "SecuritiesSaleOrdered",
      "kind": "intermediate",
      "user_label": "Sale ordered",
      "lozenge": "attention",
      "description": "Sale instruction sent to the custodian per liquidation policy."
    },
    {
      "id": "SecuritiesSaleUnknown",
      "kind": "intermediate",
      "user_label": "Sale outcome unknown",
      "lozenge": "unknown",
      "description": "Custodian gave no definite outcome for the sale instruction; no re-order."
    },
    {
      "id": "SecuritiesSold",
      "kind": "intermediate",
      "user_label": "Sold",
      "lozenge": "ok",
      "description": "Sale settled; proceeds and realized result posted; proceeds value recorded as a separate fact."
    },
    {
      "id": "SecuritiesForm8282Due",
      "kind": "intermediate",
      "user_label": "Form 8282 due",
      "lozenge": "attention",
      "description": "Disposition of a lot linked to a signed Form 8283 Section B within the reporting window; obligation tracked to filing evidence."
    },
    {
      "id": "SecuritiesGiftComplete",
      "kind": "terminal",
      "user_label": "Complete",
      "lozenge": "ok",
      "description": "Gift final, acknowledged, disposed per policy and every Form 8282 obligation satisfied or excepted."
    },
    {
      "id": "SecuritiesIntentRejected",
      "kind": "terminal",
      "user_label": "Not accepted (use intermediary)",
      "lozenge": "neutral",
      "description": "Asset is not a publicly traded security; donor directed to WFM-05."
    },
    {
      "id": "SecuritiesIntentCancelled",
      "kind": "terminal",
      "user_label": "Cancelled",
      "lozenge": "neutral",
      "description": "Donor cancelled before any delivery."
    },
    {
      "id": "SecuritiesIntentLapsed",
      "kind": "terminal",
      "user_label": "Lapsed",
      "lozenge": "neutral",
      "description": "No delivery within the declaration window."
    },
    {
      "id": "SecuritiesReturnedToBroker",
      "kind": "terminal",
      "user_label": "Returned to delivering broker",
      "lozenge": "neutral",
      "description": "Never-accepted securities redelivered to the donor's broker (UNB-RCN-FIN-013 exception)."
    },
    {
      "id": "SecuritiesReturnUnknown",
      "kind": "intermediate",
      "user_label": "Redelivery outcome unknown",
      "lozenge": "unknown",
      "description": "Redelivery to the donor's broker submitted; outcome not determinable."
    },
    {
      "id": "SecuritiesDeliveryReversed",
      "kind": "terminal",
      "user_label": "Delivery reversed by custodian",
      "lozenge": "blocked",
      "description": "Custodian reversed a misposted receipt before acceptance."
    },
    {
      "id": "SecuritiesBlocked",
      "kind": "terminal",
      "user_label": "Blocked (sanctions)",
      "lozenge": "blocked",
      "description": "Confirmed sanctions match: position blocked, OFAC report started."
    },
    {
      "id": "SecuritiesGiftCorrected",
      "kind": "correction",
      "user_label": "Corrected",
      "lozenge": "neutral",
      "description": "Linked correction child (misattributed fund, custodian restatement of lot data); original preserved."
    }
  ],
