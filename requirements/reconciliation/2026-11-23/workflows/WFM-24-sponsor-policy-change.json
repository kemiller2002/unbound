{
  "workflow_id": "WFM-24",
  "name": "Sponsor policy version lifecycle",
  "release": "R1",
  "outcome": "A sponsor policy version becomes active only after validation against platform hard controls, an impact preview against open items and approval by an authorized approver who is not its author, at a scheduled non-retroactive effective time",
  "aggregate": "PolicyVersion",
  "sources": [
    "REQ-X-045",
    "ADM-027",
    "UNB-LEG-005",
    "RCD-005",
    "UNB-TEN-010",
    "19-questions/SPONSOR-CONFIGURATION-POLICY-LIFECYCLE-AND-ISOLATION-2026-11-23.md:14"
  ],
  "observer_surfaces": [
    "UNB-UI-S-011"
  ],
  "states": [
    {
      "id": "PolicyDraft",
      "kind": "initial",
      "user_label": "Draft",
      "lozenge": "attention",
      "description": "Sponsor administrator drafts a new version of a policy (eligibility, fees, limits, permissions, dormancy, death_pending_grant_policy, routing, templates)."
    },
    {
      "id": "PolicyValidationFailed",
      "kind": "intermediate",
      "user_label": "Validation failed",
      "lozenge": "blocked",
      "description": "Schema, hard-control, protected-term or composition-conflict check failed."
    },
    {
      "id": "PolicyValidated",
      "kind": "intermediate",
      "user_label": "Validated",
      "lozenge": "attention",
      "description": "Declarative configuration validated; no conflict with platform controls."
    },
    {
      "id": "PolicyImpactPreviewed",
      "kind": "intermediate",
      "user_label": "Impact previewed",
      "lozenge": "attention",
      "description": "Diff against the active version and impact on open grants, recurring schedules, holds, fees, statements and closures computed."
    },
    {
      "id": "PolicyInReview",
      "kind": "intermediate",
      "user_label": "Awaiting approval",
      "lozenge": "attention",
      "description": "Submitted to an authorized approver."
    },
    {
      "id": "PolicyPlatformSafetyReview",
      "kind": "intermediate",
      "user_label": "Platform safety review",
      "lozenge": "attention",
      "description": "Change touches a platform-safety-classified parameter; platform risk confirms no hard control is weakened."
    },
    {
      "id": "PolicyScheduled",
      "kind": "intermediate",
      "user_label": "Scheduled",
      "lozenge": "attention",
      "description": "Approved with a future effective time."
    },
    {
      "id": "PolicyActive",
      "kind": "intermediate",
      "user_label": "Active",
      "lozenge": "ok",
      "description": "In force; new transactions pin this version."
    },
    {
      "id": "PolicySuspended",
      "kind": "intermediate",
      "user_label": "Suspended",
      "lozenge": "blocked",
      "description": "Depends on a board delegation that expired or was rescinded; dependent outcomes revert to human approval."
    },
    {
      "id": "PolicySuperseded",
      "kind": "terminal",
      "user_label": "Superseded",
      "lozenge": "neutral",
      "description": "Replaced by a newer active version."
    },
    {
      "id": "PolicyRejected",
      "kind": "terminal",
      "user_label": "Rejected",
      "lozenge": "blocked",
      "description": "Approver or platform safety review rejected the version."
    },
    {
      "id": "PolicyWithdrawn",
      "kind": "terminal",
      "user_label": "Withdrawn",
      "lozenge": "neutral",
      "description": "Author abandoned the draft or the approver cancelled a scheduled version."
    },
    {
      "id": "PolicyRemediationCase",
      "kind": "correction",
      "user_label": "Remediation",
      "lozenge": "neutral",
      "description": "Linked remediation when a defect is found in a superseded version; decisions taken under it are reviewed, never silently rewritten."
    }
  ],
  "transitions": [
    {
      "id": "WFM-24-T01",
      "from": "PolicyDraft",
      "to": "PolicyValidated",
      "trigger": "command",
      "name": "ValidatePolicyDraft",
      "actor_type": "deterministic",
      "actor_role": "Policy validator",
      "authority": "A3",
      "guards": [
        "schema-valid",
        "no-platform-hard-control-override",
        "protected-terms-intact",
        "typed-composition-no-unresolved-conflict",
        "effective-date-not-retroactive"
      ],
      "effects": [
        "validation-report"
      ],
      "idempotency_key": "(policyKey, draftHash)",
      "failure": [
        {
          "condition": "HardControlOverride",
          "to_state": "PolicyValidationFailed"
        },
        {
          "condition": "CompositionConflict",
          "to_state": "PolicyValidationFailed"
        },
        {
          "condition": "SchemaInvalid",
          "to_state": "PolicyValidationFailed"
        }
      ],
      "requirement_ids": [
