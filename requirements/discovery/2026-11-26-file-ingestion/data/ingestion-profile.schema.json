{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/unbound/requirements/discovery/2026-11-26-file-ingestion/data/ingestion-profile.schema.json",
  "title": "Unbound ingestion profile (proposed, version 1)",
  "description": "A declarative, versioned description of how one kind of inbound artifact from one kind of source becomes business commands, external observations, reference-data snapshots or evidence. Profiles contain no code and no expressions: every transform, validation rule and command mapping names an entry in a closed, reviewed catalog implemented in strongly typed F#. A profile version is immutable once activated. Status: proposed requirement artifact (UNB-ING-PRF-*); nothing is implemented. Revision 1 (after adversarial review): catalog references are checked against data/catalogs.json by gate I5; record-processing fields are required only for record-processing classes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "status",
    "title",
    "owner_scope",
    "tenant_scope",
    "artifact_class",
    "purpose",
    "sources",
    "delivery",
    "formats",
    "output",
    "retention_class",
    "sponsor_configurable"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,5}$",
      "description": "Stable identifier, dotted lower case: <domain>.<subject>.<format-or-source>."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic. A change of any field other than status creates a new version."
    },
    "status": {
      "enum": [
        "draft",
        "testing",
        "shadow",
        "active",
        "retired"
      ],
      "description": "draft: editable; testing: synthetic and sample runs only; shadow: runs on live inbound artifacts but submits nothing (parallel processing); active: submits; retired: refuses new runs, keeps history."
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description_for_ai": {
      "type": "string",
      "maxLength": 2000,
      "description": "Plain-language purpose for humans and AI assistants. Never interpreted as instructions by the platform."
    },
    "owner_scope": {
      "enum": [
        "platform",
        "sponsor"
      ],
      "description": "platform: authored and reviewed by Unbound engineering, available to sponsors; sponsor: a sponsor-scoped specialisation of a platform profile (column aliases, schedules, thresholds within bounds)."
    },
    "extends": {
      "type": "string",
      "description": "For sponsor-scoped profiles: the platform profile_id@version they specialise. A sponsor profile can only narrow or tune; it cannot add transforms, rules or mappings."
    },
    "tenant_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sponsors"
      ],
      "properties": {
        "sponsors": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "cross_tenant_source": {
          "type": "boolean",
          "default": false,
          "description": "True only for shared reference datasets (IRS, OFAC) whose snapshot is tenant-neutral. A file whose records belong to several sponsors is never accepted; institutions must deliver per-sponsor files or the adapter must split by an authenticated account mapping before an artifact exists."
        }
      }
    },
    "artifact_class": {
      "enum": [
        "command-batch",
        "observation-set",
        "reference-dataset",
        "evidence-document",
        "configuration"
      ],
      "description": "command-batch: each record becomes a business command identical to an interactive one. observation-set: facts reported by an external authority (bank, custodian) recorded append-only and used for matching and reconciliation; never commands that move money. reference-dataset: a versioned snapshot activated as a whole. evidence-document: a document attached to a case or command; extraction yields proposals only. configuration: sponsor or platform settings, applied through configuration-change commands with their own approval rules."
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z-]+)+$",
      "description": "Business purpose id from the purpose catalog, e.g. grant.recommendation, bank.account-reporting.prior-day, charity.reference.irs-bmf, contribution.noncash.appraisal. The purpose determines the allowed formats (purpose-specific allowlist)."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "principal-role",
              "institution",
              "government-dataset",
              "service-identity"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For principal-role: roles whose holders may submit. Submission authority is still checked per record against the target command."
          },
          "institution_ref": {
            "type": "string",
            "description": "Registered counterparty id (bank, custodian, payroll provider, mailroom vendor). Credentials live in the secret store and are referenced, never embedded."
          },
          "dataset_ref": {
            "type": "string",
            "description": "Registered government dataset id with pinned host and expected publication cadence."
          },
          "authentication": {
            "type": "array",
            "items": {
              "enum": [
                "interactive-session-mfa",
                "oauth-client-credentials",
                "mtls",
                "ssh-key-pinned-host",
                "pgp-signature",
                "tls-pinned-host",
                "signed-webhook"
              ]
            }
          },
          "on_behalf_of_principal": {
            "type": "boolean",
            "description": "Required true for service identities submitting command batches: the service acts for a named principal with recorded delegated authority (UNB-ING-BND-008)."
          }
        }
      }
    },
    "delivery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "browser-upload",
          "api-upload",
          "api-records",
          "sftp-pull",
          "sftp-push-managed",
          "https-scheduled-pull",
          "partner-webhook-reference",
          "mailroom-vendor",
          "email-ingestion"
        ]
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "max_bytes"
        ],
        "properties": {
          "type": {
            "enum": [
              "csv",
              "fixed-width",
              "json",
              "xml",
              "bai2",
              "iso20022-camt.052",
              "iso20022-camt.053",
              "iso20022-camt.054",
              "iso20022-pain.002",
              "nacha",
              "xlsx",
              "pdf",
              "jpeg",
              "png",
              "tiff",
              "zip-trusted-dataset",
              "lockbox-image-package"
            ]
          },
          "encoding": {
            "enum": [
              "utf-8",
              "us-ascii",
              "windows-1252"
            ]
          },
          "delimiter": {
            "enum": [
              ",",
              "|",
              "\t",
              ";"
            ]
          },
          "header_row": {
            "type": "boolean"
          },
          "schema_ref": {
            "type": "string",
            "description": "XSD/JSON Schema/layout id from the reviewed schema catalog."
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "max_records": {
            "type": "integer",
            "minimum": 1
          },
          "max_pages": {
            "type": "integer",
            "minimum": 1
          },
          "max_pixels": {
            "type": "integer",
            "minimum": 1
          },
          "max_expansion_ratio": {
            "type": "number",
            "minimum": 1,
            "description": "zip-trusted-dataset and xlsx only."
          },
          "max_entries": {
            "type": "integer",
            "minimum": 1,
            "description": "zip-trusted-dataset and lockbox-image-package only; nested archives always refused."
          },
          "password_protected": {
            "const": "refuse"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "xml"
                }
              }
            },
            "then": {
              "required": [
                "schema_ref"
              ]
            }
          }
        ]
      }
    },
    "record_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fields"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "unknown_fields": {
          "enum": [
            "hold-run",
            "ignore-and-report"
          ],
          "default": "hold-run",
          "description": "hold-run: unknown structure holds the Run with a drift report (UNB-ING-ONB-002). ignore-and-report is permitted only for reference datasets."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "source": {
                "type": "string",
                "description": "Column header, JSON pointer, XPath without functions, fixed-width position 'start:length', or BAI2/camt element id."
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Alternative headers; sponsor-configurable from an approved list."
              },
              "type": {
                "enum": [
                  "text",
                  "identifier",
                  "money-usd",
                  "decimal",
                  "integer",
                  "date",
                  "datetime",
                  "boolean",
                  "ein",
                  "cusip",
                  "isin",
                  "ticker",
                  "routing-number",
                  "account-number-masked",
                  "email",
                  "enum"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "enum_map": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "date_format": {
                "enum": [
                  "yyyy-MM-dd",
                  "MM/dd/yyyy",
                  "yyMMdd",
                  "yyyyMMdd"
                ]
              },
              "scale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8,
                "description": "Decimal places; money-usd is always 2 and rejects values with more precision rather than rounding."
              },
              "transforms": {
                "type": "array",
                "items": {
                  "enum": [
                    "trim",
                    "collapse-whitespace",
                    "upper",
                    "lower",
                    "strip-non-digits",
                    "implied-decimal-2",
                    "sign-from-indicator",
                    "nfc-normalize",
                    "neutralize-formula-prefix"
                  ]
                }
              },
              "sensitivity": {
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted-pii",
                  "restricted-financial"
                ]
              }
            }
          }
        }
      }
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
      },
      "description": "Ids from the reviewed rule catalog (e.g. money.positive, ein.checksum-and-bmf-active, fund.exists-in-tenant, date.not-future). Command-level business rules are not repeated here: they run when the command executes, exactly as for interactive requests."
    },
    "control_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "file-trailer",
            "file-header",
            "separate-manifest",
            "api-envelope",
            "requester-declared",
            "funds-received",
            "none-available"
          ]
        },
        "measures": {
          "type": "array",
          "items": {
            "enum": [
              "record-count",
              "sum-amount",
              "sum-debits",
              "sum-credits",
              "hash-total-routing",
              "opening-closing-balance",
              "sum-field"
            ]
          }
        },
        "on_mismatch": {
          "const": "reject-run",
          "description": "Fixed: a control-total mismatch always rejects the whole run."
        },
        "sum_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields summed for measure sum-field (e.g. market_value, cash, units), each reconciled separately."
        }
      }
    },
    "duplicate_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "record_key"
      ],
      "properties": {
        "artifact": {
          "type": "array",
          "items": {
            "enum": [
              "sha256",
              "source-file-id",
              "source-business-date-sequence"
            ]
          },
          "minItems": 1
        },
        "record_key": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Fields forming the record's natural identity within source and tenant; becomes the command idempotency key."
        },
        "window_days": {
          "type": "integer",
          "minimum": 1
        },
        "near_duplicate_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields compared for probable duplicates without a shared key; a match holds the record, it never discards it."
        }
      }
    },
    "atomicity": {
      "enum": [
        "all-or-nothing",
        "record-independent",
        "hold-on-threshold"
      ],
      "description": "all-or-nothing: any invalid record rejects the run (institutional observation sets, migration waves, journal batches). record-independent: each record succeeds or fails alone, exactly like separate interactive submissions (bulk grant recommendations). hold-on-threshold: record-independent unless a hold rule fires."
    },
    "hold_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "comparison",
          "value"
        ],
        "properties": {
          "metric": {
            "enum": [
              "invalid-share",
              "record-count-vs-30-day-median",
              "record-count-vs-prior-snapshot",
              "total-amount",
              "single-record-amount",
              "first-run-from-source",
              "schema-version-change",
              "late-arrival-minutes"
            ]
          },
          "comparison": {
            "enum": [
              "gt",
              "gte",
              "lt",
              "outside"
            ]
          },
          "value": {
            "type": [
              "number",
              "boolean",
              "array"
            ]
          },
          "sponsor_bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Range within which a sponsor may tune value."
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "observation",
            "reference-snapshot",
            "evidence-attachment",
            "configuration-change"
          ]
        },
        "operation": {
          "type": "string",
          "description": "For command: the Echelon.Execution operation name and version that interactive clients also use, e.g. grant.recommend@1."
        },
        "observation_type": {
          "type": "string"
        },
        "attach_to": {
          "enum": [
            "case",
            "contribution",
            "grant",
            "fund",
            "donor",
            "charity",
            "sponsor",
            "advisor"
          ]
        },
        "submission": {
          "enum": [
            "automatic",
            "requester-confirms"
          ],
          "description": "automatic only for institution and government sources; principal uploads always show the validated preview and require the requester to confirm."
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "deterministic-layout",
            "ai-proposal"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider_policy_ref": {
          "type": "string",
          "description": "Approved AI provider configuration (contractual data terms, region, retention); absent means AI is not allowed for this profile."
        },
        "corroboration": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deterministic checks each proposed value must pass against authoritative data before it can be used, e.g. ein.matches-bmf, appraisal-date.within-60-days-before-gift."
        },
        "review": {
          "enum": [
            "always-human",
            "human-when-uncorroborated"
          ]
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "enum": [
            "us-federal-reserve-business-days",
            "every-day",
            "monthly",
            "irregular"
          ]
        },
        "window_local": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]$"
        },
        "time_zone": {
          "type": "string"
        },
        "grace_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "day_of_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Purposes whose run must be Completed first. For funds-received control totals the dependency is the matching bank observation referenced by the contribution intent, not the preceding business date."
    },
    "effective_dates": {
      "enum": [
        "from-command-rules",
        "from-observation-as-of",
        "snapshot-publication-date"
      ],
      "description": "Receipt time never sets a gift, tax or accounting effective date (CNV-FIN-003)."
    },
    "retention_class": {
      "type": "string"
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "on": {
            "enum": [
              "rejected",
              "held",
              "completed-with-invalid",
              "lapsed",
              "revoked"
            ]
          },
          "to": {
            "enum": [
              "requester",
              "sponsor-operations",
              "platform-operations",
              "source-contact"
            ]
          }
        }
      }
    },
    "service_expectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_to_outcome_p95_minutes": {
          "type": "integer"
        },
        "max_queue_age_minutes": {
          "type": "integer"
        }
      }
    },
    "sponsor_configurable": {
      "type": "array",
      "items": {
        "enum": [
          "field-aliases",
          "notifications",
          "expectation-window",
          "grace-minutes",
          "hold-rule-values-within-bounds",
          "max-records-below-platform-limit",
          "retention-longer-than-minimum",
          "activation",
          "ai-extraction-enablement"
        ]
      },
      "description": "The complete list of what a sponsor administrator may change for this profile. Everything else requires a platform profile version reviewed by engineering."
    },
    "dependency_timeout_hours": {
      "type": "integer",
      "minimum": 1,
      "description": "After this, a Pending run moves to Held (UNB-ING-LCY-001 revision 1)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_class": {
            "enum": [
              "command-batch",
              "observation-set",
              "reference-dataset"
            ]
          }
        }
      },
      "then": {
        "required": [
          "atomicity",
          "duplicate_detection",
          "record_schema"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "artifact_class": {
            "const": "evidence-document"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "atomicity"
          ]
        }
      }
    }
  ]
}
