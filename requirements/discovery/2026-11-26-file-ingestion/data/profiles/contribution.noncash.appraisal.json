  "tenant_scope": {
    "sponsors": "*"
  },
  "artifact_class": "evidence-document",
  "purpose": "contribution.noncash.appraisal",
  "sources": [
    {
      "kind": "principal-role",
      "roles": [
        "donor-primary",
        "advisor-delegate",
        "sponsor-complex-asset-specialist"
      ],
      "authentication": [
        "interactive-session-mfa"
      ]
    }
  ],
  "delivery": [
    "browser-upload",
    "api-upload"
  ],
  "formats": [
    {
      "type": "pdf",
      "max_bytes": 52428800,
      "max_pages": 400,
      "password_protected": "refuse"
    }
