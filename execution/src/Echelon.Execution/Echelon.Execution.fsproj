    <Compile Include="Lifecycle.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Intake.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="InMemoryStore.fs" />
  </ItemGroup>
</Project>
